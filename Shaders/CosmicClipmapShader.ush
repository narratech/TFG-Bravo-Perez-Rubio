// ---- Entrada ----
// GridPos: UVs de la grilla sin transformar (0..N)
// ScaleFactor: (GridSpacing, GridSpacing, unused, unused)
// OriginOffset: (OriginX, OriginY) en mundo

// calcular posición plana
float2 worldXY = GridPos * ScaleFactor.xy + OriginOffset;

// z = 0 por ahora
float3 localPosition = float3(worldXY.x, worldXY.y, 0.0);

// devolver desplazamiento de posición
return localPosition;
