// Copyright Javier Bravo, David Rubio, Sergio Perez 2026 All Rights Reserved.
// PlanetarySurfaceMaster.ush - Unified Master Procedural Planetary Surface Shader
//
// Fuses the analytical Whittaker biome classification with geological sedimentary
// cliff stratification, height-blended transitions, 3-sample tangent finite difference
// normals, physical snow/wetness/magma simulation, and Toksvig specular anti-aliasing.
//
// Key Features:
//   - Analytical Whittaker Biome Engine (Gaussian RBF): 0 VRAM footprint, infinitely continuous.
//   - Geological Sedimentary Cliff Stratification: Procedural multi-octave sinusoidal rock
//     bands distorted by 3D noise along altitude shells with normal shelf perturbation.
//   - Height-Blended Layer Carving: Eliminates muddy transitions between soil, rock, and snow.
//   - Singularity-Free Frisvad Spherical Tangent Frame & 3-Sample Tangent Space Gradient.
//   - Physical Environmental Dynamics: Dynamic snowline with gravity slide-off, porous moisture
//     soil darkening, water puddles (n=1.33), and HDR volcanic thermal magma emission.
//   - Distance-Based Multi-Tier Continuous LOD & Toksvig Specular Anti-Aliasing (Firefly Elimination).
//   - Numerical Stability with Large World Coordinates (LWC).
//   - High-Performance Packed Custom Node Entry Points for Unreal Engine 5 Material Graph.
#pragma once


// CONSTANTS & CONFIGURATION
#define PLANETARY_MAX_BIOMES 8
#define PLANETARY_PI 3.14159265359f
#define PLANETARY_TWO_PI 6.28318530718f

// Continuous Distance LOD Ranges in Centimeters (Unreal Units)
#ifndef PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM
#define PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM 15000.0f  // 150 meters: near detail begins fade
#endif

#ifndef PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM
#define PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM 5000.0f   // 50 meters: smoothstep transition band
#endif

#ifndef PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM
#define PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM  300000.0f // 3 kilometers: far detail begins fade
#endif

#ifndef PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM
#define PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM  100000.0f // 1 kilometer: smoothstep transition band
#endif

#ifndef PLANETARY_MESO_FADE_START_CM
#define PLANETARY_MESO_FADE_START_CM 500000.0f          // 5 kilometers: meso relief begins fade
#endif

#ifndef PLANETARY_MESO_FADE_END_CM
#define PLANETARY_MESO_FADE_END_CM   3000000.0f         // 30 kilometers: meso relief faded
#endif

#ifndef PLANETARY_MACRO_FADE_START_CM
#define PLANETARY_MACRO_FADE_START_CM 2000000.0f        // 20 kilometers: macro relief begins fade
#endif

#ifndef PLANETARY_MACRO_FADE_END_CM
#define PLANETARY_MACRO_FADE_END_CM   10000000.0f       // 100 kilometers: macro relief faded in high orbit
#endif

// Legacy fallback macros for backward compatibility
#ifndef PLANETARY_MICRO_FADE_START_CM
#define PLANETARY_MICRO_FADE_START_CM PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM
#endif

#ifndef PLANETARY_MICRO_FADE_END_CM
#define PLANETARY_MICRO_FADE_END_CM   (PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM + PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM)
#endif

// DATA STRUCTURES

/**
 * Biome specification in Whittaker climatological phase space (Temperature, Humidity).
 */
struct FPlanetaryBiomeDefinition
{
    float2 ClimatologicalCenter; // (Temperature 0..1, Humidity 0..1)
    float2 ClimatologicalRadius; // (Sigma_Temp, Sigma_Humidity) for Gaussian RBF
    float3 BaseColor;            // Linear RGB Albedo
    float  Roughness;            // PBR Microfacet Roughness
    float  Metallic;             // PBR Metallic
    float  Specular;             // Dielectric Specular F0 (default 0.5)
    float  MicroTiling;          // Normal/relief micro-tiling multiplier
    float  NormalStrength;       // Local normal bump perturbation intensity
};

/**
 * Configuration for procedural geological sedimentary rock stratification.
 */
struct FPlanetaryStrataParameters
{
    float  Frequency;            // Vertical repetition frequency along planetary altitude shells
    float  Distortion;           // Intensity of 3D noise folding/undulation
    float3 ColorTier1;           // Sedimentary stratum color tier 1 (e.g. Sandstone / Ash)
    float3 ColorTier2;           // Sedimentary stratum color tier 2 (e.g. Iron Clay / Basalt)
    float3 ColorTier3;           // Sedimentary stratum color tier 3 (e.g. Shale / Sulfur)
    float  RoughnessDelta;       // Roughness variation across strata layers
    float  NormalStrength;       // Horizontal ledge / shelf normal perturbation intensity
};

/**
 * Configuration for 2D triplanar photographic detail layers (Near and Far distance tiers).
 */
struct FPlanetaryDetailTierParameters
{
    float Distance;              // Distance threshold in cm for detail layer activation
    float FadeRange;             // Smoothstep transition range in cm
    float SurfaceTiling;         // UV Tiling for primary biome surface
    float RockTiling;            // UV Tiling for rock / cliff faces
    float SnowTiling;            // UV Tiling for snow / ice layer
    float ColorBlend;            // Blend weight with base terrain color [0..1]
    float NormalStrength;        // Intensity of 2D triplanar normal perturbation
    float TriplanarSharpness;    // Exponent sharpness for triplanar blending (default 4.0)
};

// Aliases for clean semantic usage and backward compatibility
typedef FPlanetaryDetailTierParameters FPlanetaryNearDetailParameters;
typedef FPlanetaryDetailTierParameters FPlanetaryFarDetailParameters;

/**
 * Complete PBR evaluation output for the planetary surface.
 */
struct FPlanetaryMasterOutput
{
    float3 BaseColor;            // Modulated PBR Base Color (Linear RGB)
    float3 WorldNormal;          // Perturbed World Space Normal
    float  Roughness;            // Final roughness with Toksvig AA
    float  Metallic;             // PBR Metallic
    float  Specular;             // PBR Specular
    float  AmbientOcclusion;     // Micro-crevice & cavity occlusion
    float3 Emissive;             // Surface emission (magma, bioluminescence)
    
    // Diagnostic / Blend Masks
    float  SnowMask;             // Dynamic snow accumulation mask [0..1]
    float  SlopeMask;            // Height-blended exposed cliff rock mask [0..1]
    float  WetnessMask;          // Puddle and moisture mask [0..1]
    float  StrataMask;           // Sedimentary stratum band coordinate [0..1]
    float  SandMask;             // Coastal beach sand mask [0..1]
    float  LODFactor;            // Distance LOD blend factor [0..1]
    float  NearDetailWeight;     // Near surface detail blend factor [0..1]
    float  FarDetailWeight;      // Far surface detail blend factor [0..1]
};

// GEOMETRY & MATHEMATICAL HELPER FUNCTIONS

/**
 * Computes Large World Coordinate (LWC) stable geometry context centered on the planet.
 */
void ComputePlanetaryMasterGeometry(
    in float3 WorldPos,
    in float3 PlanetCenter,
    in float  PlanetRadius,
    in float3 MeshNormal,
    in float3 CameraWorldPos,
    out float3 OutLocalPos,
    out float3 OutRadialNormal,
    out float3 OutGeometryNormal,
    out float  OutAltitudeFromCenter,
    out float  OutCameraDistance)
{
    // Subtract planet center for large world coordinate (LWC) precision stability
    OutLocalPos = WorldPos - PlanetCenter;
    float DistFromCenter = length(OutLocalPos);
    OutRadialNormal = OutLocalPos / max(DistFromCenter, 1.0f);
    OutAltitudeFromCenter = DistFromCenter - PlanetRadius;
    
    // Fallback guard for geometric normal
    OutGeometryNormal = (length(MeshNormal) > 0.01f) ? normalize(MeshNormal) : OutRadialNormal;
    
    float CamLenSq = dot(CameraWorldPos, CameraWorldPos);
    OutCameraDistance = (CamLenSq > 100.0f) ? length(WorldPos - CameraWorldPos) : 100000.0f;
}

/**
 * Constructs a singularity-free, right-handed orthonormal tangent basis (T1, T2)
 * orthogonal to the given planetary radial unit normal N_base.
 * Uses an extended Frisvad / Hughes-Möller tangent formulation.
 */
void GetPlanetaryMasterTangentFrame(in float3 N_base, out float3 OutTangent1, out float3 OutTangent2)
{
    if (N_base.z < -0.9999f)
    {
        OutTangent1 = float3(0.0f, -1.0f, 0.0f);
        OutTangent2 = float3(-1.0f, 0.0f, 0.0f);
    }
    else
    {
        float a = 1.0f / (1.0f + N_base.z);
        float b = -N_base.x * N_base.y * a;
        OutTangent1 = float3(1.0f - N_base.x * N_base.x * a, b, -N_base.x);
        OutTangent2 = float3(b, 1.0f - N_base.y * N_base.y * a, -N_base.y);
    }
}

/**
 * Samples seamless 3D volume texture with periodic wrapping.
 */
float SampleMasterVolumeNoise(
    Texture3D InTexture,
    SamplerState InSampler,
    float3 InSamplePosUVW)
{
    return InTexture.SampleLevel(InSampler, frac(InSamplePosUVW), 0.0f).r;
}

/**
 * Computes the directional surface gradient of a 3D volume noise field directly
 * on the sphere's tangent plane using finite forward differences.
 * 
 * Takes only 3 texture samples instead of 6 (or 18 in triplanar) to compute exact
 * directional derivatives:
 *   dH/dT1 = (H(P + eps*T1) - H(P)) / eps
 *   dH/dT2 = (H(P + eps*T2) - H(P)) / eps
 */
float3 ComputeMasterVolumeSurfaceGradient(
    Texture3D InTexture,
    SamplerState InSampler,
    float3 WorldPos,
    float3 T1,
    float3 T2,
    float Frequency,
    float Epsilon,
    out float OutCenterH)
{
    float3 UV0 = WorldPos * Frequency;
    float3 UV1 = (WorldPos + T1 * Epsilon) * Frequency;
    float3 UV2 = (WorldPos + T2 * Epsilon) * Frequency;

    float H0 = SampleMasterVolumeNoise(InTexture, InSampler, UV0);
    float H1 = SampleMasterVolumeNoise(InTexture, InSampler, UV1);
    float H2 = SampleMasterVolumeNoise(InTexture, InSampler, UV2);

    OutCenterH = H0;

    float InvEps = 1.0f / max(Epsilon, 0.001f);
    float dH_dT1 = (H1 - H0) * InvEps;
    float dH_dT2 = (H2 - H0) * InvEps;

    return (T1 * dH_dT1 + T2 * dH_dT2);
}

// SPHERICAL TRIPLANAR PROJECTION (2D PHOTOGRAPHIC TEXTURES & NORMAL MAPS

/**
 * Samples a 2D diffuse/albedo texture using seamless spherical triplanar projection in planet-local space.
 * 
 * @param InTexture        - 2D Texture object
 * @param InSampler        - Texture SamplerState (Wrap)
 * @param InLocalPos       - Large World Coordinates (LWC) centered position (WorldPos - PlanetCenter)
 * @param InGeometryNormal - Unit geometric surface normal
 * @param InTiling         - Spatial UV repetition frequency (1 / cm)
 * @param InSharpness      - Blend contrast sharpness exponent (default: 4.0)
 * @return                 - Blended linear RGB color
 */
float3 SampleMasterTriplanarAlbedo(
    Texture2D InTexture,
    SamplerState InSampler,
    float3 InLocalPos,
    float3 InGeometryNormal,
    float InTiling,
    float InSharpness)
{
    float2 UV_X = InLocalPos.zy * InTiling;
    float2 UV_Y = InLocalPos.xz * InTiling;
    float2 UV_Z = InLocalPos.xy * InTiling;

    float3 BlendWeights = pow(abs(InGeometryNormal), max(InSharpness, 1.0f));
    BlendWeights /= max(BlendWeights.x + BlendWeights.y + BlendWeights.z, 0.00001f);

    float3 ColX = InTexture.SampleLevel(InSampler, UV_X, 0.0f).rgb;
    float3 ColY = InTexture.SampleLevel(InSampler, UV_Y, 0.0f).rgb;
    float3 ColZ = InTexture.SampleLevel(InSampler, UV_Z, 0.0f).rgb;

    return ColX * BlendWeights.x + ColY * BlendWeights.y + ColZ * BlendWeights.z;
}

/**
 * Samples a 2D tangent normal map using spherical triplanar projection and reconstructs
 * the perturbed normal in world space using Whiteout / Surface Gradient blending.
 *
 * @param InNormalMap      - 2D Tangent space normal map (DXT5 / BC5)
 * @param InSampler        - Texture SamplerState (Wrap)
 * @param InLocalPos       - Large World Coordinates (LWC) centered position
 * @param InGeometryNormal - Unit geometric surface normal
 * @param InTiling         - Spatial UV repetition frequency (1 / cm)
 * @param InSharpness      - Blend contrast sharpness exponent (default: 4.0)
 * @param InNormalStrength - Normal perturbation intensity [0..2]
 * @return                 - Perturbed world space normal
 */
float3 SampleMasterTriplanarNormal(
    Texture2D InNormalMap,
    SamplerState InSampler,
    float3 InLocalPos,
    float3 InGeometryNormal,
    float InTiling,
    float InSharpness,
    float InNormalStrength)
{
    float2 UV_X = InLocalPos.zy * InTiling;
    float2 UV_Y = InLocalPos.xz * InTiling;
    float2 UV_Z = InLocalPos.xy * InTiling;

    float3 BlendWeights = pow(abs(InGeometryNormal), max(InSharpness, 1.0f));
    BlendWeights /= max(BlendWeights.x + BlendWeights.y + BlendWeights.z, 0.00001f);

    // Sample and unpack tangent space normals [-1, 1]
    float3 NormX = InNormalMap.SampleLevel(InSampler, UV_X, 0.0f).rgb * 2.0f - 1.0f;
    float3 NormY = InNormalMap.SampleLevel(InSampler, UV_Y, 0.0f).rgb * 2.0f - 1.0f;
    float3 NormZ = InNormalMap.SampleLevel(InSampler, UV_Z, 0.0f).rgb * 2.0f - 1.0f;

    NormX.xy *= InNormalStrength;
    NormY.xy *= InNormalStrength;
    NormZ.xy *= InNormalStrength;

    // Tangent displacement vectors aligned to each projection axis with sign correction
    float3 dPx = float3(0.0f, NormX.y, -NormX.x * sign(InGeometryNormal.x));
    float3 dPy = float3(NormY.x * sign(InGeometryNormal.y), 0.0f, NormY.y);
    float3 dPz = float3(NormZ.x * sign(InGeometryNormal.z), NormZ.y, 0.0f);

    float3 BlendedDisplacement = dPx * BlendWeights.x + dPy * BlendWeights.y + dPz * BlendWeights.z;
    return normalize(InGeometryNormal + BlendedDisplacement);
}

// HEIGHT-BLENDED LAYER TRANSITIONS

/**
 * Two-layer height blend with contrast carving.
 * Prevents milky/muddy alpha blends by carving sharp, realistic geological transitions.
 * 
 * @param WeightA       - Base blend weight of layer A
 * @param HeightA       - Heightmap value of layer A [0..1]
 * @param WeightB       - Base blend weight of layer B
 * @param HeightB       - Heightmap value of layer B [0..1]
 * @param BlendContrast - Contrast sharpness (lower = sharper transition)
 * @return              - Normalized weight of layer B [0..1]
 */
float ComputeMasterHeightBlend2(in float WeightA, in float HeightA, in float WeightB, in float HeightB, in float BlendContrast)
{
    float Contrast = max(BlendContrast, 0.001f);
    float ElevA = WeightA + HeightA * 0.5f;
    float ElevB = WeightB + HeightB * 0.5f;
    
    float Diff = ElevB - ElevA;
    return saturate((Diff + Contrast) / (2.0f * Contrast));
}

// ============================================================================
// GEOLOGICAL SEDIMENTARY CLIFF STRATIFICATION (SEDIMENTARY BANDING)
// ============================================================================

/**
 * Evaluates procedural sedimentary rock strata along planetary altitude shells.
 * Modulates cliff color, roughness, and introduces horizontal normal ribbing/ledges.
 */
void EvaluateMasterGeologicalStrata(
    in float3 LocalPos,
    in float  AltitudeFromCenter,
    in float  NoiseSample,
    in FPlanetaryStrataParameters StrataParams,
    out float3 OutStrataTint,
    out float  OutStrataRoughnessDelta,
    out float  OutStrataNormalOffset,
    out float  OutStrata01)
{
    // Radial altitude coordinate in meters
    float BaseCoord = (AltitudeFromCenter * 0.01f) * max(StrataParams.Frequency, 0.0001f);
    
    // Distort strata coordinate with 3D noise to create undulating, folded sedimentary layers
    float DistortedCoord = BaseCoord + (NoiseSample * 2.0f - 1.0f) * StrataParams.Distortion;
    
    // Multi-octave sinusoidal strata harmonics
    float PrimaryBand   = sin(DistortedCoord);
    float SecondaryBand = sin(DistortedCoord * 2.71828f + 1.414f) * 0.5f;
    float FineBand      = cos(DistortedCoord * 7.38905f - 0.820f) * 0.25f;
    
    float CombinedStrata = (PrimaryBand + SecondaryBand + FineBand) / 1.75f; // [-1..1]
    OutStrata01 = CombinedStrata * 0.5f + 0.5f;                             // [0..1]
    
    // Tri-color sedimentary layer interpolation (Tier 1 -> Tier 2 -> Tier 3)
    if (OutStrata01 < 0.5f)
    {
        OutStrataTint = lerp(StrataParams.ColorTier1, StrataParams.ColorTier2, OutStrata01 * 2.0f);
    }
    else
    {
        OutStrataTint = lerp(StrataParams.ColorTier2, StrataParams.ColorTier3, (OutStrata01 - 0.5f) * 2.0f);
    }
    
    // Physical roughness delta across rock strata
    OutStrataRoughnessDelta = (OutStrata01 - 0.5f) * StrataParams.RoughnessDelta;
    
    // Shelf ledge derivative approximation for normal perturbation
    OutStrataNormalOffset = cos(DistortedCoord) * StrataParams.NormalStrength;
}

// WHITTAKER ANALYTICAL BIOME ENGINE

/**
 * Evaluates continuous analytical Whittaker biomes via Gaussian Radial
 * Basis Functions (RBF) in 2D climatological space (Temperature, Humidity).
 */
void EvaluateMasterWhittakerBiomes(
    in float ClimatologicalTemp,
    in float ClimatologicalHumidity,
    in FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    in int ActiveBiomeCount,
    in float SoftnessFactor,
    out float3 OutBaseColor,
    out float  OutRoughness,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutMicroTiling,
    out float  OutNormalStrength)
{
    float Weights[PLANETARY_MAX_BIOMES];
    float TotalWeight = 0.0f;
    float Sharpness = max(SoftnessFactor, 1.0f);

    // Compute Gaussian RBF distance to each biome centroid
    [unroll]
    for (int i = 0; i < PLANETARY_MAX_BIOMES; ++i)
    {
        if (i < ActiveBiomeCount)
        {
            float2 Delta = (float2(ClimatologicalTemp, ClimatologicalHumidity) - Biomes[i].ClimatologicalCenter) 
                         / max(Biomes[i].ClimatologicalRadius, float2(0.02f, 0.02f));
            float DistSq = dot(Delta, Delta);
            
            // Softmin exponential kernel
            float W = exp(-0.5f * DistSq * Sharpness);
            Weights[i] = W;
            TotalWeight += W;
        }
        else
        {
            Weights[i] = 0.0f;
        }
    }

    TotalWeight = max(TotalWeight, 0.0001f);
    float InvTotal = 1.0f / TotalWeight;

    // Accumulate blended PBR attributes
    float3 ColorAccum = float3(0.0f, 0.0f, 0.0f);
    float  RoughAccum = 0.0f;
    float  MetalAccum = 0.0f;
    float  SpecAccum  = 0.0f;
    float  TileAccum  = 0.0f;
    float  NormAccum  = 0.0f;

    [unroll]
    for (int k = 0; k < PLANETARY_MAX_BIOMES; ++k)
    {
        if (k < ActiveBiomeCount)
        {
            float NormalizedW = Weights[k] * InvTotal;
            ColorAccum += Biomes[k].BaseColor * NormalizedW;
            RoughAccum += Biomes[k].Roughness * NormalizedW;
            MetalAccum += Biomes[k].Metallic * NormalizedW;
            SpecAccum  += Biomes[k].Specular * NormalizedW;
            TileAccum  += Biomes[k].MicroTiling * NormalizedW;
            NormAccum  += Biomes[k].NormalStrength * NormalizedW;
        }
    }

    OutBaseColor      = ColorAccum;
    OutRoughness      = saturate(RoughAccum);
    OutMetallic       = saturate(MetalAccum);
    OutSpecular       = saturate(SpecAccum);
    OutMicroTiling    = max(TileAccum, 0.1f);
    OutNormalStrength = NormAccum;
}

// ============================================================================
// MANUAL BIOME & STRATA INITIALIZATION (EARTH-LIKE DEFAULTS)
// ============================================================================

/**
 * Initializes the 8 analytical Whittaker biomes and geological strata parameters
 * from user-configured material inputs.
 * Climatological layout (Temperature, Humidity) and PBR response match the
 * Earth-Like reference distribution:
 *   0: Polar Ice / Glacial
 *   1: Tundra
 *   2: Taiga / Boreal Conifer
 *   3: Temperate Grassland
 *   4: Temperate Deciduous Forest
 *   5: Arid Sand Desert
 *   6: Savannah / Scrubland
 *   7: Tropical Rainforest
 */
void InitManualPlanetaryBiomes(
    in float3 InBiomeColorPolarIce,
    in float3 InBiomeColorTundra,
    in float3 InBiomeColorTaiga,
    in float3 InBiomeColorGrassland,
    in float3 InBiomeColorForest,
    in float3 InBiomeColorDesert,
    in float3 InBiomeColorSavannah,
    in float3 InBiomeColorRainforest,
    in float3 InStrataColor1,
    in float3 InStrataColor2,
    in float3 InStrataColor3,
    in float  InStrataFrequency,
    in float  InStrataDistortion,
    in float  InStrataNormalStrength,
    out FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    out int BiomeCount,
    out FPlanetaryStrataParameters StrataParams)
{
    BiomeCount = 8;

    // 0: Polar Ice / Glacial
    Biomes[0].ClimatologicalCenter = float2(0.05f, 0.20f);
    Biomes[0].ClimatologicalRadius = float2(0.18f, 0.30f);
    Biomes[0].BaseColor            = InBiomeColorPolarIce;
    Biomes[0].Roughness            = 0.35f;
    Biomes[0].Metallic             = 0.00f;
    Biomes[0].Specular             = 0.55f;
    Biomes[0].MicroTiling          = 2.0f;
    Biomes[0].NormalStrength       = 0.6f;

    // 1: Tundra
    Biomes[1].ClimatologicalCenter = float2(0.20f, 0.30f);
    Biomes[1].ClimatologicalRadius = float2(0.18f, 0.25f);
    Biomes[1].BaseColor            = InBiomeColorTundra;
    Biomes[1].Roughness            = 0.85f;
    Biomes[1].Metallic             = 0.00f;
    Biomes[1].Specular             = 0.40f;
    Biomes[1].MicroTiling          = 1.5f;
    Biomes[1].NormalStrength       = 1.0f;

    // 2: Taiga / Boreal Conifer
    Biomes[2].ClimatologicalCenter = float2(0.35f, 0.60f);
    Biomes[2].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[2].BaseColor            = InBiomeColorTaiga;
    Biomes[2].Roughness            = 0.75f;
    Biomes[2].Metallic             = 0.00f;
    Biomes[2].Specular             = 0.45f;
    Biomes[2].MicroTiling          = 1.2f;
    Biomes[2].NormalStrength       = 1.1f;

    // 3: Temperate Grassland
    Biomes[3].ClimatologicalCenter = float2(0.55f, 0.30f);
    Biomes[3].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[3].BaseColor            = InBiomeColorGrassland;
    Biomes[3].Roughness            = 0.70f;
    Biomes[3].Metallic             = 0.00f;
    Biomes[3].Specular             = 0.45f;
    Biomes[3].MicroTiling          = 1.0f;
    Biomes[3].NormalStrength       = 0.9f;

    // 4: Temperate Deciduous Forest
    Biomes[4].ClimatologicalCenter = float2(0.60f, 0.70f);
    Biomes[4].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[4].BaseColor            = InBiomeColorForest;
    Biomes[4].Roughness            = 0.65f;
    Biomes[4].Metallic             = 0.00f;
    Biomes[4].Specular             = 0.48f;
    Biomes[4].MicroTiling          = 1.0f;
    Biomes[4].NormalStrength       = 0.9f;

    // 5: Arid Sand Desert
    Biomes[5].ClimatologicalCenter = float2(0.85f, 0.12f);
    Biomes[5].ClimatologicalRadius = float2(0.22f, 0.20f);
    Biomes[5].BaseColor            = InBiomeColorDesert;
    Biomes[5].Roughness            = 0.90f;
    Biomes[5].Metallic             = 0.00f;
    Biomes[5].Specular             = 0.35f;
    Biomes[5].MicroTiling          = 3.0f;
    Biomes[5].NormalStrength       = 0.7f;

    // 6: Savannah / Scrubland
    Biomes[6].ClimatologicalCenter = float2(0.80f, 0.42f);
    Biomes[6].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[6].BaseColor            = InBiomeColorSavannah;
    Biomes[6].Roughness            = 0.80f;
    Biomes[6].Metallic             = 0.00f;
    Biomes[6].Specular             = 0.40f;
    Biomes[6].MicroTiling          = 1.2f;
    Biomes[6].NormalStrength       = 0.85f;

    // 7: Tropical Rainforest
    Biomes[7].ClimatologicalCenter = float2(0.85f, 0.85f);
    Biomes[7].ClimatologicalRadius = float2(0.22f, 0.22f);
    Biomes[7].BaseColor            = InBiomeColorRainforest;
    Biomes[7].Roughness            = 0.55f;
    Biomes[7].Metallic             = 0.00f;
    Biomes[7].Specular             = 0.50f;
    Biomes[7].MicroTiling          = 0.8f;
    Biomes[7].NormalStrength       = 1.2f;

    // Geological Strata
    StrataParams.Frequency      = max(InStrataFrequency, 0.0001f);
    StrataParams.Distortion     = max(InStrataDistortion, 0.0f);
    StrataParams.ColorTier1     = InStrataColor1;
    StrataParams.ColorTier2     = InStrataColor2;
    StrataParams.ColorTier3     = InStrataColor3;
    StrataParams.RoughnessDelta = 0.15f;
    StrataParams.NormalStrength = max(InStrataNormalStrength, 0.0f);
}

// MAIN UNIFIED PLANETARY SURFACE EVALUATION CORE

/**
 * Master evaluation core for procedural and triplanar planetary surfaces.
 * Combines analytical Whittaker biomes, dual-octave 3D volume noise (Macro & Meso),
 * sedimentary cliff stratification, height-blended transitions, 2D spherical triplanar
 * near-surface photographic detailing, snow, wetness, magma emission, and Toksvig specular AA.
 */
void EvaluatePlanetaryMasterSurfaceCore(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InMacroFrequency,
    in float  InMicroFrequency,        // Secondary procedural meso/macro frequency (symmetrical to MacroFrequency)
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bEnableSnow,             // 1.0 to enable snow, 0.0 to disable completely
    in float3 InSnowColor,             // Snow albedo tint
    in float  InMagmaIntensity,        // 0.0 disables volcanic emission; > 0 enables HDR thermal magma
    in float  InSandMaxAltitudeKm,     // Max altitude in km above PlanetRadius for coastal beach sand
    in float  InSandMinTemperature,    // Min climate temperature [0..1] required for beach sand
    in float3 InSandColor,             // Coastal beach sand base color tint
    in float3 InBiomeColorPolarIce,    // Biome 0: Polar Ice / Glacial
    in float3 InBiomeColorTundra,      // Biome 1: Tundra
    in float3 InBiomeColorTaiga,       // Biome 2: Taiga / Boreal Conifer
    in float3 InBiomeColorGrassland,   // Biome 3: Temperate Grassland
    in float3 InBiomeColorForest,      // Biome 4: Temperate Deciduous Forest
    in float3 InBiomeColorDesert,      // Biome 5: Arid Sand Desert
    in float3 InBiomeColorSavannah,    // Biome 6: Savannah / Scrubland
    in float3 InBiomeColorRainforest,  // Biome 7: Tropical Rainforest
    in float3 InStrataColor1,          // Sedimentary stratum tier 1 (e.g. Sandstone)
    in float3 InStrataColor2,          // Sedimentary stratum tier 2 (e.g. Iron Clay)
    in float3 InStrataColor3,          // Sedimentary stratum tier 3 (e.g. Dark Shale)
    in float  InStrataFrequency,       // Vertical repetition frequency of strata bands
    in float  InStrataDistortion,      // 3D noise folding/undulation of strata bands
    in float  InStrataNormalStrength,  // Horizontal ledge / shelf normal perturbation strength
    in float  bHasNearDetail,          // 1.0 if 2D near detail textures are active
    in FPlanetaryNearDetailParameters NearDetailParams,
    in float3 InNearSurfaceTexColor,   // Pre-sampled or triplanar surface albedo (Near)
    in float3 InNearSurfaceTexNormal,  // Pre-sampled or triplanar surface normal (Near)
    in float3 InNearRockTexColor,      // Pre-sampled or triplanar rock albedo (Near)
    in float3 InNearRockTexNormal,     // Pre-sampled or triplanar rock normal (Near)
    in float3 InNearSnowTexColor,      // Pre-sampled or triplanar snow albedo (Near)
    in float3 InNearSnowTexNormal,     // Pre-sampled or triplanar snow normal (Near)
    in float3 InNearSandTexColor,      // Pre-sampled or triplanar beach sand albedo (Near)
    in float3 InNearSandTexNormal,     // Pre-sampled or triplanar beach sand normal (Near)
    in float  bHasFarDetail,           // 1.0 if 2D far detail textures are active
    in FPlanetaryFarDetailParameters FarDetailParams,
    in float3 InFarSurfaceTexColor,    // Pre-sampled or triplanar surface albedo (Far)
    in float3 InFarSurfaceTexNormal,   // Pre-sampled or triplanar surface normal (Far)
    in float3 InFarRockTexColor,       // Pre-sampled or triplanar rock albedo (Far)
    in float3 InFarRockTexNormal,      // Pre-sampled or triplanar rock normal (Far)
    in float3 InFarSnowTexColor,       // Pre-sampled or triplanar snow albedo (Far)
    in float3 InFarSnowTexNormal,      // Pre-sampled or triplanar snow normal (Far)
    in float3 InFarSandTexColor,       // Pre-sampled or triplanar beach sand albedo (Far)
    in float3 InFarSandTexNormal,      // Pre-sampled or triplanar beach sand normal (Far)
    out FPlanetaryMasterOutput OutSurface,
    out float OutTempWarped,
    out float OutHumidityWarped)
{
    // LWC Geometric Basis & Tangent Frame 
    float3 LocalPos;
    float3 RadialNormal;
    float3 GeometryNormal;
    float  AltitudeFromCenter;
    float  CameraDistance;

    ComputePlanetaryMasterGeometry(
        InWorldPos, InPlanetCenter, InPlanetRadius, InMeshWorldNormal, InCameraWorldPos,
        LocalPos, RadialNormal, GeometryNormal, AltitudeFromCenter, CameraDistance);

    // Orthonormal tangent basis on sphere strictly perpendicular to RadialNormal
    float3 T1, T2;
    GetPlanetaryMasterTangentFrame(RadialNormal, T1, T2);

    // Camera Distance Continuous LOD & Toksvig Anti-Aliasing 
    float MacroLOD = saturate(1.0f - (CameraDistance - PLANETARY_MACRO_FADE_START_CM) 
                            / max(PLANETARY_MACRO_FADE_END_CM - PLANETARY_MACRO_FADE_START_CM, 10000.0f));

    // Near-detail activation factor: smooth fade within configurable distance threshold
    float NearDist = max(NearDetailParams.Distance, 100.0f);
    float NearFade = max(NearDetailParams.FadeRange, 10.0f);
    float NearDetailWeight = 0.0f;
    if (bHasNearDetail > 0.5f)
    {
        NearDetailWeight = 1.0f - smoothstep(NearDist - NearFade, NearDist, CameraDistance);
    }

    // Far-detail activation factor: crossfades from NearDetail and fades out to pure procedural macro
    float FarDist = max(FarDetailParams.Distance, NearDist + 1000.0f);
    float FarFade = max(FarDetailParams.FadeRange, 100.0f);
    float FarDetailWeight = 0.0f;
    if (bHasFarDetail > 0.5f)
    {
        float FarEntrance = (bHasNearDetail > 0.5f) ? smoothstep(NearDist - NearFade, NearDist, CameraDistance) : (1.0f - smoothstep(FarDist - FarFade, FarDist, CameraDistance));
        float FarExit = 1.0f - smoothstep(FarDist - FarFade, FarDist, CameraDistance);
        FarDetailWeight = (bHasNearDetail > 0.5f) ? (FarEntrance * FarExit) : FarExit;
    }

    // Toksvig roughness bias to absorb orbital normal variance into microfacet roughness
    float ToksvigBias = saturate((CameraDistance - PLANETARY_MESO_FADE_START_CM) 
                                / (PLANETARY_MESO_FADE_END_CM * 2.0f)) * 0.32f;

    // 3. Climatological Inputs & 3D Domain Warping 
    float AltitudeNorm = saturate(InVertexColor.r);
    float VisualTemp   = saturate(InVertexColor.g);
    float Humidity     = saturate(InVertexColor.b);
    float SurfaceMask  = saturate(InVertexColor.a);

    // 3D Primary Macro Noise Sampling & Tangent Gradient (Symmetrical finite difference)
    float MacroH = 0.5f;
    float MacroFreq = max(InMacroFrequency, 0.000001f);
    float MacroEps  = max(2.0f / MacroFreq * 0.01f, 100.0f); // Scale-proportional finite difference

    float3 MacroGrad = ComputeMasterVolumeSurfaceGradient(
        InVolumeTexture, InVolumeSampler,
        InWorldPos, T1, T2,
        MacroFreq, MacroEps, MacroH);

    // Multi-channel organic domain warping of climate phase space
    float TempWarped     = saturate(VisualTemp + (MacroH - 0.5f) * 0.15f);
    float HumidityWarped = saturate(Humidity   + (MacroGrad.x + MacroGrad.y) * 0.08f);

    OutTempWarped     = TempWarped;
    OutHumidityWarped = HumidityWarped;

    // Manual Biome & Strata Initialization 
    FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES];
    FPlanetaryStrataParameters StrataParams;
    int BiomeCount = 8;

    InitManualPlanetaryBiomes(
        InBiomeColorPolarIce,
        InBiomeColorTundra,
        InBiomeColorTaiga,
        InBiomeColorGrassland,
        InBiomeColorForest,
        InBiomeColorDesert,
        InBiomeColorSavannah,
        InBiomeColorRainforest,
        InStrataColor1,
        InStrataColor2,
        InStrataColor3,
        InStrataFrequency,
        InStrataDistortion,
        InStrataNormalStrength,
        Biomes,
        BiomeCount,
        StrataParams);

    // 5. Whittaker Evaluation (Analytical Gaussian RBF)
    float3 BiomeColor;
    float  BiomeRoughness;
    float  BiomeMetallic;
    float  BiomeSpecular;
    float  BiomeMicroTiling;
    float  BiomeNormalScale;

    // Core procedural engine: Analytical Gaussian RBF
    EvaluateMasterWhittakerBiomes(
        TempWarped,
        HumidityWarped,
        Biomes,
        BiomeCount,
        3.5f, // Smooth transition sharpness
        BiomeColor,
        BiomeRoughness,
        BiomeMetallic,
        BiomeSpecular,
        BiomeMicroTiling,
        BiomeNormalScale);

    // Secondary Procedural Noise Layer (Meso/Macro Relief) 
    // Evaluates secondary procedural 3D volume noise layer symmetrically to MacroFrequency
    float MesoH = 0.5f;
    float MesoFreq = max(InMicroFrequency, 0.000001f);
    float MesoEps  = max(2.0f / MesoFreq * 0.01f, 20.0f);

    float3 MesoGrad = ComputeMasterVolumeSurfaceGradient(
        InVolumeTexture, InVolumeSampler,
        InWorldPos, T1, T2,
        MesoFreq * BiomeMicroTiling, MesoEps, MesoH);

    // Combined procedural surface gradient (Primary Macro + Secondary Meso)
    float3 ProceduralGradient = (MacroGrad * 0.6f + MesoGrad * (0.4f * BiomeNormalScale)) * MacroLOD;

    // Tangent normal perturbation strictly perpendicular to GeometryNormal
    float EffNormalStrength = InNormalStrength * MacroLOD;
    float3 TangentPerturb = (T1 * dot(ProceduralGradient, T1) + T2 * dot(ProceduralGradient, T2)) * EffNormalStrength;
    float3 PerturbedNormal = normalize(GeometryNormal - TangentPerturb);

    // Slope Calculation & Geological Sedimentary Cliff Stratification 
    float SlopeCos = saturate(dot(RadialNormal, PerturbedNormal));
    float RawSlope = 1.0f - SlopeCos; // 0 on flat ground, 1 on vertical cliffs

    // Perturb slope boundary slightly with 3D noise for natural irregular cliff borders
    float PerturbedSlope = saturate(RawSlope + (MacroH - 0.5f) * 0.20f);

    float HalfFalloff = max(InSlopeCliffFalloff * 0.5f, 0.001f);
    float CliffSlopeWeight = smoothstep(InSlopeCliffThreshold - HalfFalloff, InSlopeCliffThreshold + HalfFalloff, PerturbedSlope);

    // Height-blended transition between flat biome soil and bare cliff rock
    float HeightFlat = saturate(MesoH);
    float HeightCliff = saturate(1.0f - MesoH * 0.6f);
    float CliffMask = ComputeMasterHeightBlend2(
        1.0f - CliffSlopeWeight, HeightFlat,
        CliffSlopeWeight, HeightCliff,
        0.15f);

    // Procedural Sedimentary Strata evaluation on cliffs
    float3 StrataTint;
    float  StrataRoughDelta;
    float  StrataNormOffset;
    float  Strata01;

    EvaluateMasterGeologicalStrata(
        LocalPos, AltitudeFromCenter, MacroH, StrataParams,
        StrataTint, StrataRoughDelta, StrataNormOffset, Strata01);

    // Modulate cliff albedo with geological sedimentary strata
    float3 CliffAlbedo = StrataTint * 1.15f;
    float  CliffRoughness = saturate(0.88f + StrataRoughDelta);

    // Coastal Beach Sand Layer (Altitude in km & Min Temperature) 
    // Below InSandMaxAltitudeKm and above InSandMinTemperature, flat terrain becomes beach sand.
    // Steep cliffs (CliffMask) always override sand so rock remains exposed on slopes.
    float SandBlended = 0.0f;
    float SandMask = 0.0f;
    if (InSandMinTemperature < 0.999f)
    {
        float AltitudeKm = AltitudeFromCenter * 0.00001f; // 1 km = 100,000 cm
        float SandFadeKm = 0.015f;                        // 15m smooth coastal transition band
        float SandAltWarped = AltitudeKm + (MacroH - 0.5f) * 0.01f;
        float SandAltWeight = 1.0f - smoothstep(InSandMaxAltitudeKm - SandFadeKm, InSandMaxAltitudeKm, SandAltWarped);
        float SandTempWeight = smoothstep(InSandMinTemperature - 0.04f, InSandMinTemperature + 0.04f, TempWarped);
        float SandRaw = SandAltWeight * SandTempWeight;

        if (SandRaw > 0.001f)
        {
            SandBlended = ComputeMasterHeightBlend2(
                1.0f - SandRaw, HeightFlat,
                SandRaw, 0.65f,
                0.16f) * saturate(SandRaw * 2.0f);
            SandMask = SandBlended * (1.0f - CliffMask);
        }
    }

    // Blend flat biome terrain with beach sand first, then override with stratified cliff rock
    float3 FlatAlbedo    = lerp(BiomeColor, InSandColor, SandBlended);
    float  FlatRoughness = lerp(BiomeRoughness, 0.88f, SandBlended);
    BiomeMetallic        = lerp(BiomeMetallic, 0.0f, SandMask);
    BiomeSpecular        = lerp(BiomeSpecular, 0.38f, SandMask);

    float3 BaseAlbedo   = lerp(FlatAlbedo, CliffAlbedo, CliffMask);
    float  EffRoughness = lerp(FlatRoughness, CliffRoughness, CliffMask);

    // Add horizontal sedimentary shelf ribbing to the normal on steep cliffs
    if (CliffMask > 0.01f)
    {
        PerturbedNormal = normalize(PerturbedNormal + RadialNormal * (StrataNormOffset * CliffMask * 0.4f));
    }

    // Dynamic Snowline & Glaciation (Gravity Slide-Off Physics) 
    float SnowMask = 0.0f;
    if (bEnableSnow > 0.5f && InSnowTemperatureThreshold > 0.001f)
    {
        float SnowThreshold = max(InSnowTemperatureThreshold, 0.001f);
        float SnowRaw = saturate((SnowThreshold - TempWarped) / max(SnowThreshold * 0.6f, 0.02f));

        // Slope slide-off damping: gravity prevents snow from sticking to steep cliffs
        float SnowSlopeDamp = smoothstep(0.50f, 0.20f, RawSlope);
        float SnowWeight = SnowRaw * SnowSlopeDamp;

        // Height-blend snow accumulation: snow settles on ridges and plateaus first
        SnowMask = ComputeMasterHeightBlend2(
            1.0f - SnowWeight, 1.0f - HeightFlat,
            SnowWeight, 0.85f,
            0.18f) * saturate(SnowWeight * 2.0f);

        if (SnowMask > 0.001f)
        {
            BaseAlbedo    = lerp(BaseAlbedo, InSnowColor, SnowMask);
            EffRoughness  = lerp(EffRoughness, 0.65f, SnowMask);
            BiomeMetallic = lerp(BiomeMetallic, 0.0f, SnowMask);
            BiomeSpecular = lerp(BiomeSpecular, 0.50f, SnowMask);
        }
    }

    // Multi-Tier 2D Photographic Triplanar Detail Layers (Near & Far) 
    float TotalDetailWeight = NearDetailWeight + FarDetailWeight;
    if (TotalDetailWeight > 0.001f)
    {
        // Compute relative blend weight between Near and Far details
        float NearWeightNorm = NearDetailWeight / max(TotalDetailWeight, 0.0001f);
        float FarWeightNorm  = FarDetailWeight  / max(TotalDetailWeight, 0.0001f);

        // Composite Flat Surface, Rock, and Snow textures blending Near and Far tiers
        float3 BlendedSurfaceColor = InNearSurfaceTexColor * NearWeightNorm + InFarSurfaceTexColor * FarWeightNorm;
        float3 BlendedSurfaceNormal = normalize(InNearSurfaceTexNormal * NearWeightNorm + InFarSurfaceTexNormal * FarWeightNorm);

        float3 BlendedRockColor = InNearRockTexColor * NearWeightNorm + InFarRockTexColor * FarWeightNorm;
        float3 BlendedRockNormal = normalize(InNearRockTexNormal * NearWeightNorm + InFarRockTexNormal * FarWeightNorm);

        float3 BlendedSnowColor = InNearSnowTexColor * NearWeightNorm + InFarSnowTexColor * FarWeightNorm;
        float3 BlendedSnowNormal = normalize(InNearSnowTexNormal * NearWeightNorm + InFarSnowTexNormal * FarWeightNorm);

        float3 BlendedSandColor = InNearSandTexColor * NearWeightNorm + InFarSandTexColor * FarWeightNorm;
        float3 BlendedSandNormal = normalize(InNearSandTexNormal * NearWeightNorm + InFarSandTexNormal * FarWeightNorm);

        // Blend Surface with Beach Sand first, then override with Rock based on CliffMask
        float3 BlendedFlatAlbedo = lerp(BlendedSurfaceColor, BlendedSandColor, SandBlended);
        float3 BlendedFlatNormal = normalize(lerp(BlendedSurfaceNormal, BlendedSandNormal, SandBlended));

        float3 BlendedTexAlbedo = lerp(BlendedFlatAlbedo, BlendedRockColor, CliffMask);
        float3 BlendedTexNormal = normalize(lerp(BlendedFlatNormal, BlendedRockNormal, CliffMask));

        // Blend with Snow based on SnowMask
        if (SnowMask > 0.001f)
        {
            BlendedTexAlbedo = lerp(BlendedTexAlbedo, BlendedSnowColor, SnowMask);
            BlendedTexNormal = normalize(lerp(BlendedTexNormal, BlendedSnowNormal, SnowMask));
        }

        // Effective blend factors for color and normal strength
        float EffColorBlend = saturate(NearDetailParams.ColorBlend * NearWeightNorm + FarDetailParams.ColorBlend * FarWeightNorm);
        float EffNormalStr  = saturate(NearDetailParams.NormalStrength * NearWeightNorm + FarDetailParams.NormalStrength * FarWeightNorm);

        // Modulate Base Terrain Color with Photographic Detail
        float3 ModulatedAlbedo = BaseAlbedo * BlendedTexAlbedo * 2.0f;
        float3 DirectAlbedo    = BlendedTexAlbedo;
        float3 CompositeDetail = lerp(ModulatedAlbedo, DirectAlbedo, 0.35f);

        float FinalDetailWeight = saturate(TotalDetailWeight);
        BaseAlbedo = lerp(BaseAlbedo, CompositeDetail, FinalDetailWeight * EffColorBlend);

        // Perturb World Normal with High-Res Detail Normal Map
        PerturbedNormal = normalize(lerp(PerturbedNormal, BlendedTexNormal, FinalDetailWeight * EffNormalStr));
    }

    // Moisture, Wetness & Water Puddle Physics
    float WetnessMask = 0.0f;
    if (InWetnessIntensity > 0.01f)
    {
        float PuddleDepression = saturate(1.0f - RawSlope * 1.5f);
        WetnessMask = saturate((Humidity - 0.42f) / 0.50f) * PuddleDepression * InWetnessIntensity;

        WetnessMask *= (1.0f - SnowMask) * (1.0f - CliffMask * 0.75f);
        BaseAlbedo *= (1.0f - 0.35f * WetnessMask);
        EffRoughness = lerp(EffRoughness, 0.03f, WetnessMask * 0.90f);
        BiomeSpecular = lerp(BiomeSpecular, 0.55f, WetnessMask);
    }

    // Toksvig Specular Anti-Aliasing Integration 
    float FinalRoughness = saturate(sqrt(EffRoughness * EffRoughness + ToksvigBias * ToksvigBias));

    // Volcanic / Thermal Emission 
    float3 Emissive = float3(0.0f, 0.0f, 0.0f);
    if (InMagmaIntensity > 0.001f)
    {
        float MagmaMask = saturate((0.32f - AltitudeNorm) / 0.20f) * saturate(1.0f - RawSlope * 1.2f);
        MagmaMask *= saturate(1.0f - MacroH * 1.6f);

        float3 MagmaHDR = float3(3.0f, 0.40f, 0.02f);
        Emissive = MagmaHDR * (MagmaMask * 5.0f * InMagmaIntensity);
        BaseAlbedo = lerp(BaseAlbedo, float3(0.04f, 0.02f, 0.01f), saturate(MagmaMask * InMagmaIntensity));
    }

    // Pack Output Struct
    OutSurface.BaseColor        = BaseAlbedo;
    OutSurface.WorldNormal      = PerturbedNormal;
    OutSurface.Roughness        = FinalRoughness;
    OutSurface.Metallic         = BiomeMetallic;
    OutSurface.Specular         = BiomeSpecular;
    OutSurface.AmbientOcclusion = lerp(0.85f, 1.0f, MacroH);
    OutSurface.Emissive         = Emissive;
    OutSurface.SnowMask         = SnowMask;
    OutSurface.SlopeMask        = CliffMask;
    OutSurface.WetnessMask      = WetnessMask;
    OutSurface.StrataMask       = Strata01;
    OutSurface.SandMask         = SandMask;
    OutSurface.LODFactor        = MacroLOD;
    OutSurface.NearDetailWeight = NearDetailWeight;
    OutSurface.FarDetailWeight  = FarDetailWeight;
}

// CONVENIENCE EVALUATION INTERFACES (2D TRIPLANAR DETAIL FLOW: NEAR & FAR)

/**
 * Master Evaluation with In-Shader 2D Spherical Triplanar Textures & Normal Maps + Coastal Beach Sand.
 * Beach sand reuses InNearSurfaceAlbedoSampler to avoid consuming extra UE5 sampler slots.
 */
void EvaluatePlanetaryMasterSurfaceWithTriplanarSand(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bEnableSnow,
    in float3 InSnowColor,
    in float  InMagmaIntensity,
    in float  InSandMaxAltitudeKm,
    in float  InSandMinTemperature,
    in float3 InSandColor,
    in float3 InBiomeColorPolarIce,
    in float3 InBiomeColorTundra,
    in float3 InBiomeColorTaiga,
    in float3 InBiomeColorGrassland,
    in float3 InBiomeColorForest,
    in float3 InBiomeColorDesert,
    in float3 InBiomeColorSavannah,
    in float3 InBiomeColorRainforest,
    in float3 InStrataColor1,
    in float3 InStrataColor2,
    in float3 InStrataColor3,
    in float  InStrataFrequency,
    in float  InStrataDistortion,
    in float  InStrataNormalStrength,
    in Texture2D InNearSurfaceAlbedo,
    in SamplerState InNearSurfaceAlbedoSampler,
    in Texture2D InNearSurfaceNormal,
    in SamplerState InNearSurfaceNormalSampler,
    in Texture2D InNearRockAlbedo,
    in SamplerState InNearRockAlbedoSampler,
    in Texture2D InNearRockNormal,
    in SamplerState InNearRockNormalSampler,
    in Texture2D InNearSnowAlbedo,
    in SamplerState InNearSnowAlbedoSampler,
    in Texture2D InNearSnowNormal,
    in SamplerState InNearSnowNormalSampler,
    in Texture2D InNearSandAlbedo,
    in Texture2D InNearSandNormal,
    in float  InNearDetailDistance,
    in float  InNearDetailFadeRange,
    in float  InNearDetailTiling,
    in float  InNearDetailRockTiling,
    in float  InNearDetailSnowTiling,
    in float  InNearDetailColorBlend,
    in float  InNearDetailNormalStrength,
    in float  InFarDetailDistance,
    in float  InFarDetailFadeRange,
    in float  InFarDetailTiling,
    in float  InFarDetailRockTiling,
    in float  InFarDetailSnowTiling,
    in float  InFarDetailColorBlend,
    in float  InFarDetailNormalStrength,
    out FPlanetaryMasterOutput OutSurface)
{
    float3 LocalPos = InWorldPos - InPlanetCenter;
    float DistFromCenter = length(LocalPos);
    float3 RadialNormal = LocalPos / max(DistFromCenter, 1.0f);
    float3 GeometryNormal = (length(InMeshWorldNormal) > 0.01f) ? normalize(InMeshWorldNormal) : RadialNormal;

    float CamLenSq = dot(InCameraWorldPos, InCameraWorldPos);
    float CameraDistance = (CamLenSq > 100.0f) ? length(InWorldPos - InCameraWorldPos) : 100000.0f;

    // Conservative fast-skip guard for coastal sand sampling (0 extra texture fetches outside beaches)
    float AltitudeKm = (DistFromCenter - InPlanetRadius) * 0.00001f;
    bool bMightHaveSand = (InSandMinTemperature < 0.999f)
                       && (AltitudeKm <= InSandMaxAltitudeKm + 0.05f)
                       && (saturate(InVertexColor.g) >= InSandMinTemperature - 0.20f);

    // Near Parameters
    FPlanetaryNearDetailParameters NearParams;
    NearParams.Distance = InNearDetailDistance > 10.0f ? InNearDetailDistance : PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM;
    NearParams.FadeRange = InNearDetailFadeRange > 5.0f ? InNearDetailFadeRange : PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM;
    NearParams.SurfaceTiling = max(InNearDetailTiling, 0.00001f);
    NearParams.RockTiling = max(InNearDetailRockTiling, 0.00001f);
    NearParams.SnowTiling = max(InNearDetailSnowTiling, 0.00001f);
    NearParams.ColorBlend = saturate(InNearDetailColorBlend);
    NearParams.NormalStrength = max(InNearDetailNormalStrength, 0.0f);
    NearParams.TriplanarSharpness = 4.0f;

    // Far Parameters
    FPlanetaryFarDetailParameters FarParams;
    FarParams.Distance = InFarDetailDistance > NearParams.Distance ? InFarDetailDistance : PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM;
    FarParams.FadeRange = InFarDetailFadeRange > 5.0f ? InFarDetailFadeRange : PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM;
    FarParams.SurfaceTiling = max(InFarDetailTiling, 0.000001f);
    FarParams.RockTiling = max(InFarDetailRockTiling, 0.000001f);
    FarParams.SnowTiling = max(InFarDetailSnowTiling, 0.000001f);
    FarParams.ColorBlend = saturate(InFarDetailColorBlend);
    FarParams.NormalStrength = max(InFarDetailNormalStrength, 0.0f);
    FarParams.TriplanarSharpness = 4.0f;

    float NearWeight = 1.0f - smoothstep(NearParams.Distance - NearParams.FadeRange, NearParams.Distance, CameraDistance);
    float FarEntrance = smoothstep(NearParams.Distance - NearParams.FadeRange, NearParams.Distance, CameraDistance);
    float FarExit = 1.0f - smoothstep(FarParams.Distance - FarParams.FadeRange, FarParams.Distance, CameraDistance);
    float FarWeight = FarEntrance * FarExit;

    // Near Triplanar Sampling
    float3 NearSurfaceTexCol  = float3(1.0f, 1.0f, 1.0f);
    float3 NearSurfaceTexNorm = GeometryNormal;
    float3 NearRockTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 NearRockTexNorm    = GeometryNormal;
    float3 NearSnowTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 NearSnowTexNorm    = GeometryNormal;
    float3 NearSandTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 NearSandTexNorm    = GeometryNormal;

    if (NearWeight > 0.001f)
    {
        NearSurfaceTexCol  = SampleMasterTriplanarAlbedo(InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, NearParams.SurfaceTiling, 4.0f);
        NearSurfaceTexNorm = SampleMasterTriplanarNormal(InNearSurfaceNormal, InNearSurfaceNormalSampler, LocalPos, GeometryNormal, NearParams.SurfaceTiling, 4.0f, NearParams.NormalStrength);

        NearRockTexCol     = SampleMasterTriplanarAlbedo(InNearRockAlbedo, InNearRockAlbedoSampler, LocalPos, GeometryNormal, NearParams.RockTiling, 4.0f);
        NearRockTexNorm    = SampleMasterTriplanarNormal(InNearRockNormal, InNearRockNormalSampler, LocalPos, GeometryNormal, NearParams.RockTiling, 4.0f, NearParams.NormalStrength);

        if (bEnableSnow > 0.5f)
        {
            NearSnowTexCol     = SampleMasterTriplanarAlbedo(InNearSnowAlbedo, InNearSnowAlbedoSampler, LocalPos, GeometryNormal, NearParams.SnowTiling, 4.0f);
            NearSnowTexNorm    = SampleMasterTriplanarNormal(InNearSnowNormal, InNearSnowNormalSampler, LocalPos, GeometryNormal, NearParams.SnowTiling, 4.0f, NearParams.NormalStrength);
        }

        if (bMightHaveSand)
        {
            NearSandTexCol     = SampleMasterTriplanarAlbedo(InNearSandAlbedo, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, NearParams.SurfaceTiling, 4.0f);
            NearSandTexNorm    = SampleMasterTriplanarNormal(InNearSandNormal, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, NearParams.SurfaceTiling, 4.0f, NearParams.NormalStrength);
        }
    }

    // Far Triplanar Sampling
    float3 FarSurfaceTexCol  = float3(1.0f, 1.0f, 1.0f);
    float3 FarSurfaceTexNorm = GeometryNormal;
    float3 FarRockTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 FarRockTexNorm    = GeometryNormal;
    float3 FarSnowTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 FarSnowTexNorm    = GeometryNormal;
    float3 FarSandTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 FarSandTexNorm    = GeometryNormal;

    if (FarWeight > 0.001f)
    {
        FarSurfaceTexCol  = SampleMasterTriplanarAlbedo(InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, FarParams.SurfaceTiling, 4.0f);
        FarSurfaceTexNorm = SampleMasterTriplanarNormal(InNearSurfaceNormal, InNearSurfaceNormalSampler, LocalPos, GeometryNormal, FarParams.SurfaceTiling, 4.0f, FarParams.NormalStrength);

        FarRockTexCol     = SampleMasterTriplanarAlbedo(InNearRockAlbedo, InNearRockAlbedoSampler, LocalPos, GeometryNormal, FarParams.RockTiling, 4.0f);
        FarRockTexNorm    = SampleMasterTriplanarNormal(InNearRockNormal, InNearRockNormalSampler, LocalPos, GeometryNormal, FarParams.RockTiling, 4.0f, FarParams.NormalStrength);

        if (bEnableSnow > 0.5f)
        {
            FarSnowTexCol     = SampleMasterTriplanarAlbedo(InNearSnowAlbedo, InNearSnowAlbedoSampler, LocalPos, GeometryNormal, FarParams.SnowTiling, 4.0f);
            FarSnowTexNorm    = SampleMasterTriplanarNormal(InNearSnowNormal, InNearSnowNormalSampler, LocalPos, GeometryNormal, FarParams.SnowTiling, 4.0f, FarParams.NormalStrength);
        }

        if (bMightHaveSand)
        {
            FarSandTexCol     = SampleMasterTriplanarAlbedo(InNearSandAlbedo, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, FarParams.SurfaceTiling, 4.0f);
            FarSandTexNorm    = SampleMasterTriplanarNormal(InNearSandNormal, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, FarParams.SurfaceTiling, 4.0f, FarParams.NormalStrength);
        }
    }

    float TempWarped, HumWarped;
    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bEnableSnow, InSnowColor, InMagmaIntensity,
        InSandMaxAltitudeKm, InSandMinTemperature, InSandColor,
        InBiomeColorPolarIce, InBiomeColorTundra, InBiomeColorTaiga, InBiomeColorGrassland,
        InBiomeColorForest, InBiomeColorDesert, InBiomeColorSavannah, InBiomeColorRainforest,
        InStrataColor1, InStrataColor2, InStrataColor3,
        InStrataFrequency, InStrataDistortion, InStrataNormalStrength,
        1.0f, NearParams,
        NearSurfaceTexCol, NearSurfaceTexNorm,
        NearRockTexCol, NearRockTexNorm,
        NearSnowTexCol, NearSnowTexNorm,
        NearSandTexCol, NearSandTexNorm,
        1.0f, FarParams,
        FarSurfaceTexCol, FarSurfaceTexNorm,
        FarRockTexCol, FarRockTexNorm,
        FarSnowTexCol, FarSnowTexNorm,
        FarSandTexCol, FarSandTexNorm,
        OutSurface, TempWarped, HumWarped);
}

// UE5 MATERIAL GRAPH CUSTOM NODE ENTRY POINT

// Beach Sand Extension (float3 InVertexColor, out float OutEmissive)
float4 EvaluatePlanetaryMasterFull(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float3 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity,
    float  bEnableSnow,
    float3 InSnowColor,
    float  InMagmaIntensity,
    float  InSandMaxAltitudeKm,
    float  InSandMinTemperature,
    float3 InSandColor,
    float3 InBiomeColorPolarIce,
    float3 InBiomeColorTundra,
    float3 InBiomeColorTaiga,
    float3 InBiomeColorGrassland,
    float3 InBiomeColorForest,
    float3 InBiomeColorDesert,
    float3 InBiomeColorSavannah,
    float3 InBiomeColorRainforest,
    float3 InStrataColor1,
    float3 InStrataColor2,
    float3 InStrataColor3,
    float  InStrataFrequency,
    float  InStrataDistortion,
    float  InStrataNormalStrength,
    Texture2D InNearSurfaceAlbedo,
    SamplerState InNearSurfaceAlbedoSampler,
    Texture2D InNearSurfaceNormal,
    SamplerState InNearSurfaceNormalSampler,
    Texture2D InNearRockAlbedo,
    SamplerState InNearRockAlbedoSampler,
    Texture2D InNearRockNormal,
    SamplerState InNearRockNormalSampler,
    Texture2D InNearSnowAlbedo,
    SamplerState InNearSnowAlbedoSampler,
    Texture2D InNearSnowNormal,
    SamplerState InNearSnowNormalSampler,
    Texture2D InNearSandAlbedo,
    Texture2D InNearSandNormal,
    float  InNearDetailDistance,
    float  InNearDetailFadeRange,
    float  InNearDetailTiling,
    float  InNearDetailRockTiling,
    float  InNearDetailSnowTiling,
    float  InNearDetailColorBlend,
    float  InNearDetailNormalStrength,
    float  InFarDetailDistance,
    float  InFarDetailFadeRange,
    float  InFarDetailTiling,
    float  InFarDetailRockTiling,
    float  InFarDetailSnowTiling,
    float  InFarDetailColorBlend,
    float  InFarDetailNormalStrength,
    out float3 OutWorldNormal,
    out float  OutEmissive,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutAO,
    out float4 OutMasks)
{
    FPlanetaryMasterOutput OutSurface;
    EvaluatePlanetaryMasterSurfaceWithTriplanarSand(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        float4(InVertexColor, 1.0f), InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bEnableSnow, InSnowColor, InMagmaIntensity,
        InSandMaxAltitudeKm, InSandMinTemperature, InSandColor,
        InBiomeColorPolarIce, InBiomeColorTundra, InBiomeColorTaiga, InBiomeColorGrassland,
        InBiomeColorForest, InBiomeColorDesert, InBiomeColorSavannah, InBiomeColorRainforest,
        InStrataColor1, InStrataColor2, InStrataColor3,
        InStrataFrequency, InStrataDistortion, InStrataNormalStrength,
        InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler,
        InNearSurfaceNormal, InNearSurfaceNormalSampler,
        InNearRockAlbedo, InNearRockAlbedoSampler,
        InNearRockNormal, InNearRockNormalSampler,
        InNearSnowAlbedo, InNearSnowAlbedoSampler,
        InNearSnowNormal, InNearSnowNormalSampler,
        InNearSandAlbedo, InNearSandNormal,
        InNearDetailDistance, InNearDetailFadeRange, InNearDetailTiling,
        InNearDetailRockTiling, InNearDetailSnowTiling, InNearDetailColorBlend,
        InNearDetailNormalStrength,
        InFarDetailDistance, InFarDetailFadeRange, InFarDetailTiling,
        InFarDetailRockTiling, InFarDetailSnowTiling, InFarDetailColorBlend,
        InFarDetailNormalStrength,
        OutSurface);

    OutWorldNormal = OutSurface.WorldNormal;
    OutEmissive    = max(OutSurface.Emissive.r, max(OutSurface.Emissive.g, OutSurface.Emissive.b));
    OutMetallic    = OutSurface.Metallic;
    OutSpecular    = OutSurface.Specular;
    OutAO          = OutSurface.AmbientOcclusion;
    OutMasks       = float4(OutSurface.SnowMask, OutSurface.SlopeMask, OutSurface.WetnessMask, OutSurface.StrataMask);

    return float4(OutSurface.BaseColor, OutSurface.Roughness);
}

