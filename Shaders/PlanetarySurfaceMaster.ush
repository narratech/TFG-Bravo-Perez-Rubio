// Copyright Javier Bravo, David Rubio, Sergio Perez 2026 All Rights Reserved.
// PlanetarySurfaceMaster.ush - Unified Master Procedural Planetary Surface Shader
//
// Fuses the analytical Whittaker biome classification with geological sedimentary
// cliff stratification, height-blended transitions, 3-sample tangent finite difference
// normals, physical snow/wetness/magma simulation, and Toksvig specular anti-aliasing.
//
// Key Features:
//   - Analytical Whittaker Biome Engine (Gaussian RBF): 0 VRAM footprint, infinitely continuous.
//   - Optional 2D Whittaker LUT Override: Artistic texture fallback toggleable per material.
//   - Geological Sedimentary Cliff Stratification: Procedural multi-octave sinusoidal rock
//     bands distorted by 3D noise along altitude shells with normal shelf perturbation.
//   - Height-Blended Layer Carving: Eliminates muddy transitions between soil, rock, and snow.
//   - Singularity-Free Frisvad Spherical Tangent Frame & 3-Sample Tangent Space Gradient.
//   - Physical Environmental Dynamics: Dynamic snowline with gravity slide-off, porous moisture
//     soil darkening, water puddles (n=1.33), and HDR volcanic thermal magma emission.
//   - Distance-Based Multi-Tier Continuous LOD & Toksvig Specular Anti-Aliasing (Firefly Elimination).
//   - Numerical Stability with Large World Coordinates (LWC).
//   - High-Performance Packed Custom Node Entry Points for Unreal Engine 5 Material Graph.
#pragma once

// ============================================================================
// CONSTANTS & CONFIGURATION
// ============================================================================
#define PLANETARY_MAX_BIOMES 8
#define PLANETARY_PI 3.14159265359f
#define PLANETARY_TWO_PI 6.28318530718f

// Continuous Distance LOD Ranges in Centimeters (Unreal Units)
#ifndef PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM
#define PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM 15000.0f  // 150 meters: near detail begins fade
#endif

#ifndef PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM
#define PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM 5000.0f   // 50 meters: smoothstep transition band
#endif

#ifndef PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM
#define PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM  300000.0f // 3 kilometers: far detail begins fade
#endif

#ifndef PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM
#define PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM  100000.0f // 1 kilometer: smoothstep transition band
#endif

#ifndef PLANETARY_MESO_FADE_START_CM
#define PLANETARY_MESO_FADE_START_CM 500000.0f          // 5 kilometers: meso relief begins fade
#endif

#ifndef PLANETARY_MESO_FADE_END_CM
#define PLANETARY_MESO_FADE_END_CM   3000000.0f         // 30 kilometers: meso relief faded
#endif

#ifndef PLANETARY_MACRO_FADE_START_CM
#define PLANETARY_MACRO_FADE_START_CM 2000000.0f        // 20 kilometers: macro relief begins fade
#endif

#ifndef PLANETARY_MACRO_FADE_END_CM
#define PLANETARY_MACRO_FADE_END_CM   10000000.0f       // 100 kilometers: macro relief faded in high orbit
#endif

// Legacy fallback macros for backward compatibility
#ifndef PLANETARY_MICRO_FADE_START_CM
#define PLANETARY_MICRO_FADE_START_CM PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM
#endif

#ifndef PLANETARY_MICRO_FADE_END_CM
#define PLANETARY_MICRO_FADE_END_CM   (PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM + PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM)
#endif

// ============================================================================
// DATA STRUCTURES
// ============================================================================

/**
 * Biome specification in Whittaker climatological phase space (Temperature, Humidity).
 */
struct FPlanetaryBiomeDefinition
{
    float2 ClimatologicalCenter; // (Temperature 0..1, Humidity 0..1)
    float2 ClimatologicalRadius; // (Sigma_Temp, Sigma_Humidity) for Gaussian RBF
    float3 BaseColor;            // Linear RGB Albedo
    float  Roughness;            // PBR Microfacet Roughness
    float  Metallic;             // PBR Metallic
    float  Specular;             // Dielectric Specular F0 (default 0.5)
    float  MicroTiling;          // Normal/relief micro-tiling multiplier
    float  NormalStrength;       // Local normal bump perturbation intensity
};

/**
 * Configuration for procedural geological sedimentary rock stratification.
 */
struct FPlanetaryStrataParameters
{
    float  Frequency;            // Vertical repetition frequency along planetary altitude shells
    float  Distortion;           // Intensity of 3D noise folding/undulation
    float3 ColorTier1;           // Sedimentary stratum color tier 1 (e.g. Sandstone / Ash)
    float3 ColorTier2;           // Sedimentary stratum color tier 2 (e.g. Iron Clay / Basalt)
    float3 ColorTier3;           // Sedimentary stratum color tier 3 (e.g. Shale / Sulfur)
    float  RoughnessDelta;       // Roughness variation across strata layers
    float  NormalStrength;       // Horizontal ledge / shelf normal perturbation intensity
};

/**
 * Configuration for 2D triplanar photographic detail layers (Near and Far distance tiers).
 */
struct FPlanetaryDetailTierParameters
{
    float Distance;              // Distance threshold in cm for detail layer activation
    float FadeRange;             // Smoothstep transition range in cm
    float SurfaceTiling;         // UV Tiling for primary biome surface
    float RockTiling;            // UV Tiling for rock / cliff faces
    float SnowTiling;            // UV Tiling for snow / ice layer
    float ColorBlend;            // Blend weight with base terrain color [0..1]
    float NormalStrength;        // Intensity of 2D triplanar normal perturbation
    float TriplanarSharpness;    // Exponent sharpness for triplanar blending (default 4.0)
};

// Aliases for clean semantic usage and backward compatibility
typedef FPlanetaryDetailTierParameters FPlanetaryNearDetailParameters;
typedef FPlanetaryDetailTierParameters FPlanetaryFarDetailParameters;

/**
 * Complete PBR evaluation output for the planetary surface.
 */
struct FPlanetaryMasterOutput
{
    float3 BaseColor;            // Modulated PBR Base Color (Linear RGB)
    float3 WorldNormal;          // Perturbed World Space Normal
    float  Roughness;            // Final roughness with Toksvig AA
    float  Metallic;             // PBR Metallic
    float  Specular;             // PBR Specular
    float  AmbientOcclusion;     // Micro-crevice & cavity occlusion
    float3 Emissive;             // Surface emission (magma, bioluminescence)
    
    // Diagnostic / Blend Masks
    float  SnowMask;             // Dynamic snow accumulation mask [0..1]
    float  SlopeMask;            // Height-blended exposed cliff rock mask [0..1]
    float  WetnessMask;          // Puddle and moisture mask [0..1]
    float  StrataMask;           // Sedimentary stratum band coordinate [0..1]
    float  LODFactor;            // Distance LOD blend factor [0..1]
    float  NearDetailWeight;     // Near surface detail blend factor [0..1]
    float  FarDetailWeight;      // Far surface detail blend factor [0..1]
};

// ============================================================================
// GEOMETRY & MATHEMATICAL HELPER FUNCTIONS
// ============================================================================

/**
 * Computes Large World Coordinate (LWC) stable geometry context centered on the planet.
 */
void ComputePlanetaryMasterGeometry(
    in float3 WorldPos,
    in float3 PlanetCenter,
    in float  PlanetRadius,
    in float3 MeshNormal,
    in float3 CameraWorldPos,
    out float3 OutLocalPos,
    out float3 OutRadialNormal,
    out float3 OutGeometryNormal,
    out float  OutAltitudeFromCenter,
    out float  OutCameraDistance)
{
    // Subtract planet center for large world coordinate (LWC) precision stability
    OutLocalPos = WorldPos - PlanetCenter;
    float DistFromCenter = length(OutLocalPos);
    OutRadialNormal = OutLocalPos / max(DistFromCenter, 1.0f);
    OutAltitudeFromCenter = DistFromCenter - PlanetRadius;
    
    // Fallback guard for geometric normal
    OutGeometryNormal = (length(MeshNormal) > 0.01f) ? normalize(MeshNormal) : OutRadialNormal;
    
    float CamLenSq = dot(CameraWorldPos, CameraWorldPos);
    OutCameraDistance = (CamLenSq > 100.0f) ? length(WorldPos - CameraWorldPos) : 100000.0f;
}

/**
 * Constructs a singularity-free, right-handed orthonormal tangent basis (T1, T2)
 * orthogonal to the given planetary radial unit normal N_base.
 * Uses an extended Frisvad / Hughes-Möller tangent formulation.
 */
void GetPlanetaryMasterTangentFrame(in float3 N_base, out float3 OutTangent1, out float3 OutTangent2)
{
    if (N_base.z < -0.9999f)
    {
        OutTangent1 = float3(0.0f, -1.0f, 0.0f);
        OutTangent2 = float3(-1.0f, 0.0f, 0.0f);
    }
    else
    {
        float a = 1.0f / (1.0f + N_base.z);
        float b = -N_base.x * N_base.y * a;
        OutTangent1 = float3(1.0f - N_base.x * N_base.x * a, b, -N_base.x);
        OutTangent2 = float3(b, 1.0f - N_base.y * N_base.y * a, -N_base.y);
    }
}

/**
 * Fast procedural 3D noise hash fallback when 3D texture is unavailable.
 */
float PlanetaryMasterAnalyticalNoise3D(float3 P)
{
    float3 i = floor(P);
    float3 f = frac(P);
    f = f * f * (3.0f - 2.0f * f); // Smoothstep hermite curve

    float3 step = float3(110.0f, 241.0f, 17.0f);
    float n = dot(i, step);

    float4 v1 = frac(sin(n + float4(0.0f, step.x, step.y, step.x + step.y)) * 43758.5453f);
    float4 v2 = frac(sin(n + step.z + float4(0.0f, step.x, step.y, step.x + step.y)) * 43758.5453f);

    float4 v12 = lerp(v1, v2, f.z);
    float2 v12_y = lerp(v12.xz, v12.yw, f.y);
    return lerp(v12_y.x, v12_y.y, f.x);
}

/**
 * Samples seamless 3D volume texture with periodic wrapping.
 */
float SampleMasterVolumeNoise(
    Texture3D InTexture,
    SamplerState InSampler,
    float3 InSamplePosUVW)
{
    return InTexture.SampleLevel(InSampler, frac(InSamplePosUVW), 0.0f).r;
}

/**
 * Computes the directional surface gradient of a 3D volume noise field directly
 * on the sphere's tangent plane using finite forward differences.
 * 
 * Takes only 3 texture samples instead of 6 (or 18 in triplanar) to compute exact
 * directional derivatives:
 *   dH/dT1 = (H(P + eps*T1) - H(P)) / eps
 *   dH/dT2 = (H(P + eps*T2) - H(P)) / eps
 */
float3 ComputeMasterVolumeSurfaceGradient(
    Texture3D InTexture,
    SamplerState InSampler,
    float3 WorldPos,
    float3 T1,
    float3 T2,
    float Frequency,
    float Epsilon,
    out float OutCenterH)
{
    float3 UV0 = WorldPos * Frequency;
    float3 UV1 = (WorldPos + T1 * Epsilon) * Frequency;
    float3 UV2 = (WorldPos + T2 * Epsilon) * Frequency;

    float H0 = SampleMasterVolumeNoise(InTexture, InSampler, UV0);
    float H1 = SampleMasterVolumeNoise(InTexture, InSampler, UV1);
    float H2 = SampleMasterVolumeNoise(InTexture, InSampler, UV2);

    OutCenterH = H0;

    float InvEps = 1.0f / max(Epsilon, 0.001f);
    float dH_dT1 = (H1 - H0) * InvEps;
    float dH_dT2 = (H2 - H0) * InvEps;

    return (T1 * dH_dT1 + T2 * dH_dT2);
}

// ============================================================================
// SPHERICAL TRIPLANAR PROJECTION (2D PHOTOGRAPHIC TEXTURES & NORMAL MAPS)
// ============================================================================

/**
 * Samples a 2D diffuse/albedo texture using seamless spherical triplanar projection in planet-local space.
 * 
 * @param InTexture        - 2D Texture object
 * @param InSampler        - Texture SamplerState (Wrap)
 * @param InLocalPos       - Large World Coordinates (LWC) centered position (WorldPos - PlanetCenter)
 * @param InGeometryNormal - Unit geometric surface normal
 * @param InTiling         - Spatial UV repetition frequency (1 / cm)
 * @param InSharpness      - Blend contrast sharpness exponent (default: 4.0)
 * @return                 - Blended linear RGB color
 */
float3 SampleMasterTriplanarAlbedo(
    Texture2D InTexture,
    SamplerState InSampler,
    float3 InLocalPos,
    float3 InGeometryNormal,
    float InTiling,
    float InSharpness)
{
    float2 UV_X = InLocalPos.zy * InTiling;
    float2 UV_Y = InLocalPos.xz * InTiling;
    float2 UV_Z = InLocalPos.xy * InTiling;

    float3 BlendWeights = pow(abs(InGeometryNormal), max(InSharpness, 1.0f));
    BlendWeights /= max(BlendWeights.x + BlendWeights.y + BlendWeights.z, 0.00001f);

    float3 ColX = InTexture.SampleLevel(InSampler, UV_X, 0.0f).rgb;
    float3 ColY = InTexture.SampleLevel(InSampler, UV_Y, 0.0f).rgb;
    float3 ColZ = InTexture.SampleLevel(InSampler, UV_Z, 0.0f).rgb;

    return ColX * BlendWeights.x + ColY * BlendWeights.y + ColZ * BlendWeights.z;
}

/**
 * Samples a 2D tangent normal map using spherical triplanar projection and reconstructs
 * the perturbed normal in world space using Whiteout / Surface Gradient blending.
 *
 * @param InNormalMap      - 2D Tangent space normal map (DXT5 / BC5)
 * @param InSampler        - Texture SamplerState (Wrap)
 * @param InLocalPos       - Large World Coordinates (LWC) centered position
 * @param InGeometryNormal - Unit geometric surface normal
 * @param InTiling         - Spatial UV repetition frequency (1 / cm)
 * @param InSharpness      - Blend contrast sharpness exponent (default: 4.0)
 * @param InNormalStrength - Normal perturbation intensity [0..2]
 * @return                 - Perturbed world space normal
 */
float3 SampleMasterTriplanarNormal(
    Texture2D InNormalMap,
    SamplerState InSampler,
    float3 InLocalPos,
    float3 InGeometryNormal,
    float InTiling,
    float InSharpness,
    float InNormalStrength)
{
    float2 UV_X = InLocalPos.zy * InTiling;
    float2 UV_Y = InLocalPos.xz * InTiling;
    float2 UV_Z = InLocalPos.xy * InTiling;

    float3 BlendWeights = pow(abs(InGeometryNormal), max(InSharpness, 1.0f));
    BlendWeights /= max(BlendWeights.x + BlendWeights.y + BlendWeights.z, 0.00001f);

    // Sample and unpack tangent space normals [-1, 1]
    float3 NormX = InNormalMap.SampleLevel(InSampler, UV_X, 0.0f).rgb * 2.0f - 1.0f;
    float3 NormY = InNormalMap.SampleLevel(InSampler, UV_Y, 0.0f).rgb * 2.0f - 1.0f;
    float3 NormZ = InNormalMap.SampleLevel(InSampler, UV_Z, 0.0f).rgb * 2.0f - 1.0f;

    NormX.xy *= InNormalStrength;
    NormY.xy *= InNormalStrength;
    NormZ.xy *= InNormalStrength;

    // Tangent displacement vectors aligned to each projection axis with sign correction
    float3 dPx = float3(0.0f, NormX.y, -NormX.x * sign(InGeometryNormal.x));
    float3 dPy = float3(NormY.x * sign(InGeometryNormal.y), 0.0f, NormY.y);
    float3 dPz = float3(NormZ.x * sign(InGeometryNormal.z), NormZ.y, 0.0f);

    float3 BlendedDisplacement = dPx * BlendWeights.x + dPy * BlendWeights.y + dPz * BlendWeights.z;
    return normalize(InGeometryNormal + BlendedDisplacement);
}

// ============================================================================
// HEIGHT-BLENDED LAYER TRANSITIONS
// ============================================================================

/**
 * Two-layer height blend with contrast carving.
 * Prevents milky/muddy alpha blends by carving sharp, realistic geological transitions.
 * 
 * @param WeightA       - Base blend weight of layer A
 * @param HeightA       - Heightmap value of layer A [0..1]
 * @param WeightB       - Base blend weight of layer B
 * @param HeightB       - Heightmap value of layer B [0..1]
 * @param BlendContrast - Contrast sharpness (lower = sharper transition)
 * @return              - Normalized weight of layer B [0..1]
 */
float ComputeMasterHeightBlend2(
    in float WeightA,
    in float HeightA,
    in float WeightB,
    in float HeightB,
    in float BlendContrast)
{
    float Contrast = max(BlendContrast, 0.001f);
    float ElevA = WeightA + HeightA * 0.5f;
    float ElevB = WeightB + HeightB * 0.5f;
    
    float Diff = ElevB - ElevA;
    return saturate((Diff + Contrast) / (2.0f * Contrast));
}

// ============================================================================
// GEOLOGICAL SEDIMENTARY CLIFF STRATIFICATION (SEDIMENTARY BANDING)
// ============================================================================

/**
 * Evaluates procedural sedimentary rock strata along planetary altitude shells.
 * Modulates cliff color, roughness, and introduces horizontal normal ribbing/ledges.
 */
void EvaluateMasterGeologicalStrata(
    in float3 LocalPos,
    in float  AltitudeFromCenter,
    in float  NoiseSample,
    in FPlanetaryStrataParameters StrataParams,
    out float3 OutStrataTint,
    out float  OutStrataRoughnessDelta,
    out float  OutStrataNormalOffset,
    out float  OutStrata01)
{
    // Radial altitude coordinate in meters
    float BaseCoord = (AltitudeFromCenter * 0.01f) * max(StrataParams.Frequency, 0.0001f);
    
    // Distort strata coordinate with 3D noise to create undulating, folded sedimentary layers
    float DistortedCoord = BaseCoord + (NoiseSample * 2.0f - 1.0f) * StrataParams.Distortion;
    
    // Multi-octave sinusoidal strata harmonics
    float PrimaryBand   = sin(DistortedCoord);
    float SecondaryBand = sin(DistortedCoord * 2.71828f + 1.414f) * 0.5f;
    float FineBand      = cos(DistortedCoord * 7.38905f - 0.820f) * 0.25f;
    
    float CombinedStrata = (PrimaryBand + SecondaryBand + FineBand) / 1.75f; // [-1..1]
    OutStrata01 = CombinedStrata * 0.5f + 0.5f;                             // [0..1]
    
    // Tri-color sedimentary layer interpolation (Tier 1 -> Tier 2 -> Tier 3)
    if (OutStrata01 < 0.5f)
    {
        OutStrataTint = lerp(StrataParams.ColorTier1, StrataParams.ColorTier2, OutStrata01 * 2.0f);
    }
    else
    {
        OutStrataTint = lerp(StrataParams.ColorTier2, StrataParams.ColorTier3, (OutStrata01 - 0.5f) * 2.0f);
    }
    
    // Physical roughness delta across rock strata
    OutStrataRoughnessDelta = (OutStrata01 - 0.5f) * StrataParams.RoughnessDelta;
    
    // Shelf ledge derivative approximation for normal perturbation
    OutStrataNormalOffset = cos(DistortedCoord) * StrataParams.NormalStrength;
}

// ============================================================================
// WHITTAKER ANALYTICAL BIOME ENGINE
// ============================================================================

/**
 * Evaluates continuous analytical Whittaker biomes via Gaussian Radial
 * Basis Functions (RBF) in 2D climatological space (Temperature, Humidity).
 * 
 * Eliminates 2D LUT texture fetches, bilinear compression artifacts, and color banding.
 */
void EvaluateMasterWhittakerBiomes(
    in float ClimatologicalTemp,
    in float ClimatologicalHumidity,
    in FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    in int ActiveBiomeCount,
    in float SoftnessFactor,
    out float3 OutBaseColor,
    out float  OutRoughness,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutMicroTiling,
    out float  OutNormalStrength)
{
    float Weights[PLANETARY_MAX_BIOMES];
    float TotalWeight = 0.0f;
    float Sharpness = max(SoftnessFactor, 1.0f);

    // Compute Gaussian RBF distance to each biome centroid
    [unroll]
    for (int i = 0; i < PLANETARY_MAX_BIOMES; ++i)
    {
        if (i < ActiveBiomeCount)
        {
            float2 Delta = (float2(ClimatologicalTemp, ClimatologicalHumidity) - Biomes[i].ClimatologicalCenter) 
                         / max(Biomes[i].ClimatologicalRadius, float2(0.02f, 0.02f));
            float DistSq = dot(Delta, Delta);
            
            // Softmin exponential kernel
            float W = exp(-0.5f * DistSq * Sharpness);
            Weights[i] = W;
            TotalWeight += W;
        }
        else
        {
            Weights[i] = 0.0f;
        }
    }

    TotalWeight = max(TotalWeight, 0.0001f);
    float InvTotal = 1.0f / TotalWeight;

    // Accumulate blended PBR attributes
    float3 ColorAccum = float3(0.0f, 0.0f, 0.0f);
    float  RoughAccum = 0.0f;
    float  MetalAccum = 0.0f;
    float  SpecAccum  = 0.0f;
    float  TileAccum  = 0.0f;
    float  NormAccum  = 0.0f;

    [unroll]
    for (int k = 0; k < PLANETARY_MAX_BIOMES; ++k)
    {
        if (k < ActiveBiomeCount)
        {
            float NormalizedW = Weights[k] * InvTotal;
            ColorAccum += Biomes[k].BaseColor * NormalizedW;
            RoughAccum += Biomes[k].Roughness * NormalizedW;
            MetalAccum += Biomes[k].Metallic * NormalizedW;
            SpecAccum  += Biomes[k].Specular * NormalizedW;
            TileAccum  += Biomes[k].MicroTiling * NormalizedW;
            NormAccum  += Biomes[k].NormalStrength * NormalizedW;
        }
    }

    OutBaseColor      = ColorAccum;
    OutRoughness      = saturate(RoughAccum);
    OutMetallic       = saturate(MetalAccum);
    OutSpecular       = saturate(SpecAccum);
    OutMicroTiling    = max(TileAccum, 0.1f);
    OutNormalStrength = NormAccum;
}

// ============================================================================
// PLANETARY ARCHETYPE PRESETS
// ============================================================================

/**
 * Initializes Earth-Like terrestrial archetype with 8 biomes & sedimentary strata:
 *   0: Polar Ice / Glacial
 *   1: Tundra
 *   2: Taiga / Boreal Conifer
 *   3: Temperate Grassland
 *   4: Temperate Deciduous Forest
 *   5: Arid Sand Desert
 *   6: Savannah / Scrubland
 *   7: Tropical Rainforest
 */
void InitEarthLikeMasterArchetype(
    out FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    out int BiomeCount,
    out FPlanetaryStrataParameters StrataParams)
{
    BiomeCount = 8;

    // 0: Polar Ice / Glacial
    Biomes[0].ClimatologicalCenter = float2(0.05f, 0.20f);
    Biomes[0].ClimatologicalRadius = float2(0.18f, 0.30f);
    Biomes[0].BaseColor            = float3(0.88f, 0.92f, 0.96f);
    Biomes[0].Roughness            = 0.35f;
    Biomes[0].Metallic             = 0.00f;
    Biomes[0].Specular             = 0.55f;
    Biomes[0].MicroTiling          = 2.0f;
    Biomes[0].NormalStrength       = 0.6f;

    // 1: Tundra
    Biomes[1].ClimatologicalCenter = float2(0.20f, 0.30f);
    Biomes[1].ClimatologicalRadius = float2(0.18f, 0.25f);
    Biomes[1].BaseColor            = float3(0.42f, 0.40f, 0.32f);
    Biomes[1].Roughness            = 0.85f;
    Biomes[1].Metallic             = 0.00f;
    Biomes[1].Specular             = 0.40f;
    Biomes[1].MicroTiling          = 1.5f;
    Biomes[1].NormalStrength       = 1.0f;

    // 2: Taiga / Boreal Conifer
    Biomes[2].ClimatologicalCenter = float2(0.35f, 0.60f);
    Biomes[2].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[2].BaseColor            = float3(0.12f, 0.22f, 0.10f);
    Biomes[2].Roughness            = 0.75f;
    Biomes[2].Metallic             = 0.00f;
    Biomes[2].Specular             = 0.45f;
    Biomes[2].MicroTiling          = 1.2f;
    Biomes[2].NormalStrength       = 1.1f;

    // 3: Temperate Grassland
    Biomes[3].ClimatologicalCenter = float2(0.55f, 0.30f);
    Biomes[3].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[3].BaseColor            = float3(0.32f, 0.38f, 0.16f);
    Biomes[3].Roughness            = 0.70f;
    Biomes[3].Metallic             = 0.00f;
    Biomes[3].Specular             = 0.45f;
    Biomes[3].MicroTiling          = 1.0f;
    Biomes[3].NormalStrength       = 0.9f;

    // 4: Temperate Deciduous Forest
    Biomes[4].ClimatologicalCenter = float2(0.60f, 0.70f);
    Biomes[4].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[4].BaseColor            = float3(0.14f, 0.30f, 0.09f);
    Biomes[4].Roughness            = 0.65f;
    Biomes[4].Metallic             = 0.00f;
    Biomes[4].Specular             = 0.48f;
    Biomes[4].MicroTiling          = 1.0f;
    Biomes[4].NormalStrength       = 0.9f;

    // 5: Arid Sand Desert
    Biomes[5].ClimatologicalCenter = float2(0.85f, 0.12f);
    Biomes[5].ClimatologicalRadius = float2(0.22f, 0.20f);
    Biomes[5].BaseColor            = float3(0.76f, 0.58f, 0.35f);
    Biomes[5].Roughness            = 0.90f;
    Biomes[5].Metallic             = 0.00f;
    Biomes[5].Specular             = 0.35f;
    Biomes[5].MicroTiling          = 3.0f;
    Biomes[5].NormalStrength       = 0.7f;

    // 6: Savannah / Scrubland
    Biomes[6].ClimatologicalCenter = float2(0.80f, 0.42f);
    Biomes[6].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[6].BaseColor            = float3(0.55f, 0.48f, 0.22f);
    Biomes[6].Roughness            = 0.80f;
    Biomes[6].Metallic             = 0.00f;
    Biomes[6].Specular             = 0.40f;
    Biomes[6].MicroTiling          = 1.2f;
    Biomes[6].NormalStrength       = 0.85f;

    // 7: Tropical Rainforest
    Biomes[7].ClimatologicalCenter = float2(0.85f, 0.85f);
    Biomes[7].ClimatologicalRadius = float2(0.22f, 0.22f);
    Biomes[7].BaseColor            = float3(0.06f, 0.20f, 0.05f);
    Biomes[7].Roughness            = 0.55f;
    Biomes[7].Metallic             = 0.00f;
    Biomes[7].Specular             = 0.50f;
    Biomes[7].MicroTiling          = 0.8f;
    Biomes[7].NormalStrength       = 1.2f;

    // Geological Strata: Sandstone, Iron Clay, Shale
    StrataParams.Frequency      = 0.08f;
    StrataParams.Distortion     = 0.45f;
    StrataParams.ColorTier1     = float3(0.58f, 0.45f, 0.32f); // Sandstone
    StrataParams.ColorTier2     = float3(0.42f, 0.25f, 0.18f); // Iron Clay
    StrataParams.ColorTier3     = float3(0.22f, 0.20f, 0.22f); // Dark Shale
    StrataParams.RoughnessDelta = 0.15f;
    StrataParams.NormalStrength = 0.35f;
}

/**
 * Initializes Mars-Like ferric desert / barren rocky archetype:
 *   0: Polar CO2 Dry Ice Caps
 *   1: High Altitude Basaltic Plateau
 *   2: Ferric Orange Sand Dunes
 *   3: Deep Canyon Ochre Rock
 *   4: Dark Basalt Ejecta Plains
 */
void InitMarsLikeMasterArchetype(
    out FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    out int BiomeCount,
    out FPlanetaryStrataParameters StrataParams)
{
    BiomeCount = 5;

    // 0: Polar Dry Ice Caps
    Biomes[0].ClimatologicalCenter = float2(0.10f, 0.50f);
    Biomes[0].ClimatologicalRadius = float2(0.22f, 0.50f);
    Biomes[0].BaseColor            = float3(0.85f, 0.82f, 0.80f);
    Biomes[0].Roughness            = 0.40f;
    Biomes[0].Metallic             = 0.00f;
    Biomes[0].Specular             = 0.50f;
    Biomes[0].MicroTiling          = 1.5f;
    Biomes[0].NormalStrength       = 0.7f;

    // 1: High Altitude Basaltic Plateau
    Biomes[1].ClimatologicalCenter = float2(0.35f, 0.30f);
    Biomes[1].ClimatologicalRadius = float2(0.25f, 0.40f);
    Biomes[1].BaseColor            = float3(0.32f, 0.22f, 0.18f);
    Biomes[1].Roughness            = 0.92f;
    Biomes[1].Metallic             = 0.02f;
    Biomes[1].Specular             = 0.35f;
    Biomes[1].MicroTiling          = 2.0f;
    Biomes[1].NormalStrength       = 1.3f;

    // 2: Ferric Orange Sand Dunes
    Biomes[2].ClimatologicalCenter = float2(0.65f, 0.20f);
    Biomes[2].ClimatologicalRadius = float2(0.28f, 0.35f);
    Biomes[2].BaseColor            = float3(0.68f, 0.28f, 0.12f);
    Biomes[2].Roughness            = 0.85f;
    Biomes[2].Metallic             = 0.00f;
    Biomes[2].Specular             = 0.30f;
    Biomes[2].MicroTiling          = 2.5f;
    Biomes[2].NormalStrength       = 0.8f;

    // 3: Deep Canyon Ochre Rock
    Biomes[3].ClimatologicalCenter = float2(0.70f, 0.75f);
    Biomes[3].ClimatologicalRadius = float2(0.25f, 0.35f);
    Biomes[3].BaseColor            = float3(0.48f, 0.20f, 0.10f);
    Biomes[3].Roughness            = 0.88f;
    Biomes[3].Metallic             = 0.01f;
    Biomes[3].Specular             = 0.35f;
    Biomes[3].MicroTiling          = 1.8f;
    Biomes[3].NormalStrength       = 1.4f;

    // 4: Dark Basalt Ejecta Plains
    Biomes[4].ClimatologicalCenter = float2(0.90f, 0.45f);
    Biomes[4].ClimatologicalRadius = float2(0.25f, 0.40f);
    Biomes[4].BaseColor            = float3(0.18f, 0.14f, 0.12f);
    Biomes[4].Roughness            = 0.95f;
    Biomes[4].Metallic             = 0.05f;
    Biomes[4].Specular             = 0.32f;
    Biomes[4].MicroTiling          = 2.2f;
    Biomes[4].NormalStrength       = 1.2f;

    // Geological Strata: Ferric Orange, Deep Ochre, Dark Basalt
    StrataParams.Frequency      = 0.06f;
    StrataParams.Distortion     = 0.60f;
    StrataParams.ColorTier1     = float3(0.65f, 0.26f, 0.12f); // Ferric Sandstone
    StrataParams.ColorTier2     = float3(0.42f, 0.16f, 0.08f); // Ochre Hematite
    StrataParams.ColorTier3     = float3(0.16f, 0.12f, 0.10f); // Dark Basalt Bed
    StrataParams.RoughnessDelta = 0.18f;
    StrataParams.NormalStrength = 0.45f;
}

/**
 * Initializes Ice Moon archetype (Europa / Enceladus):
 *   0: Pure Translucent Blue Ice
 *   1: White Compacted Firn & Frost
 *   2: Tholin Organic Amber Ridges
 *   3: Fractured Chaotic Rifts
 */
void InitIceMoonMasterArchetype(
    out FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    out int BiomeCount,
    out FPlanetaryStrataParameters StrataParams)
{
    BiomeCount = 4;

    // 0: Pure Glacial Blue Ice
    Biomes[0].ClimatologicalCenter = float2(0.20f, 0.30f);
