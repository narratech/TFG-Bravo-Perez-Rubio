// 8. With LUT, float3 InVertexColor, out float OutEmissive (Direct match for existing Unreal Engine Material custom node setup)
float4 EvaluatePlanetaryMasterFull(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float3 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity,
    float  bUseLUTOverride,
    Texture2D InOptionalWhittakerLUT,
    SamplerState InOptionalWhittakerLUTSampler,
    out float3 OutWorldNormal,
    out float  OutEmissive,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutAO,
    out float4 OutMasks)
{
    float3 Emiss3;
    float4 Res = EvaluatePlanetaryMasterFull(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos, float4(InVertexColor, 1.0f), InMeshWorldNormal,
        InVolumeTexture, InVolumeSampler, InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bUseLUTOverride, InOptionalWhittakerLUT, InOptionalWhittakerLUTSampler,
        OutWorldNormal, Emiss3, OutMetallic, OutSpecular, OutAO, OutMasks);
    OutEmissive = max(Emiss3.r, max(Emiss3.g, Emiss3.b));
    return Res;
}
