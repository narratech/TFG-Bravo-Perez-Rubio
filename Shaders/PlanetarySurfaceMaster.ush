// 2. With Triplanar 2D Textures (All 6 Texture2D + Sampler Pairs), float4 InVertexColor, out float3 OutEmissive
float4 EvaluatePlanetaryMasterFull(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity,
    float  bUseLUTOverride,
    Texture2D InOptionalWhittakerLUT,
    SamplerState InOptionalWhittakerLUTSampler,
    Texture2D InNearSurfaceAlbedo,
    SamplerState InNearSurfaceAlbedoSampler,
    Texture2D InNearSurfaceNormal,
    SamplerState InNearSurfaceNormalSampler,
    Texture2D InNearRockAlbedo,
    SamplerState InNearRockAlbedoSampler,
    Texture2D InNearRockNormal,
    SamplerState InNearRockNormalSampler,
    Texture2D InNearSnowAlbedo,
    SamplerState InNearSnowAlbedoSampler,
    Texture2D InNearSnowNormal,
    SamplerState InNearSnowNormalSampler,
    float  InNearDetailDistance,
    float  InNearDetailFadeRange,
    float  InNearDetailTiling,
    float  InNearDetailRockTiling,
    float  InNearDetailSnowTiling,
    float  InNearDetailColorBlend,
    float  InNearDetailNormalStrength,
    out float3 OutWorldNormal,
    out float3 OutEmissive,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutAO,
    out float4 OutMasks)
{
    return EvaluatePlanetaryMasterFull(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos, InVertexColor, InMeshWorldNormal,
        InVolumeTexture, InVolumeSampler, InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bUseLUTOverride, InOptionalWhittakerLUT, InOptionalWhittakerLUTSampler,
        InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler,
        InNearSurfaceNormal, InNearSurfaceNormalSampler,
        InNearRockAlbedo, InNearRockAlbedoSampler,
        InNearRockNormal, InNearRockNormalSampler,
        InNearSnowAlbedo, InNearSnowAlbedoSampler,
        InNearSnowNormal, InNearSnowNormalSampler,
        InNearDetailDistance, InNearDetailFadeRange, InNearDetailTiling,
        InNearDetailRockTiling, InNearDetailSnowTiling, InNearDetailColorBlend,
        InNearDetailNormalStrength,
        PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM, PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM,
        InNearDetailTiling * 0.1f, InNearDetailRockTiling * 0.1f, InNearDetailSnowTiling * 0.1f,
        InNearDetailColorBlend * 0.7f, InNearDetailNormalStrength * 0.6f,
        OutWorldNormal, OutEmissive, OutMetallic, OutSpecular, OutAO, OutMasks);
}

