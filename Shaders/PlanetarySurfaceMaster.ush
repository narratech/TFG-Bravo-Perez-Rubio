    Biomes[0].BaseColor            = float3(0.55f, 0.75f, 0.88f);
    Biomes[0].Roughness            = 0.18f;
    Biomes[0].Metallic             = 0.00f;
    Biomes[0].Specular             = 0.60f;
    Biomes[0].MicroTiling          = 1.0f;
    Biomes[0].NormalStrength       = 0.5f;

    // 1: White Compacted Firn & Frost
    Biomes[1].ClimatologicalCenter = float2(0.20f, 0.80f);
    Biomes[1].ClimatologicalRadius = float2(0.30f, 0.40f);
    Biomes[1].BaseColor            = float3(0.92f, 0.94f, 0.97f);
    Biomes[1].Roughness            = 0.65f;
    Biomes[1].Metallic             = 0.00f;
    Biomes[1].Specular             = 0.50f;
    Biomes[1].MicroTiling          = 2.0f;
    Biomes[1].NormalStrength       = 0.8f;

    // 2: Tholin Organic Amber Ridges
    Biomes[2].ClimatologicalCenter = float2(0.70f, 0.30f);
    Biomes[2].ClimatologicalRadius = float2(0.35f, 0.40f);
    Biomes[2].BaseColor            = float3(0.52f, 0.30f, 0.18f);
    Biomes[2].Roughness            = 0.75f;
    Biomes[2].Metallic             = 0.00f;
    Biomes[2].Specular             = 0.40f;
    Biomes[2].MicroTiling          = 2.5f;
    Biomes[2].NormalStrength       = 1.3f;

    // 3: Fractured Chaotic Rifts
    Biomes[3].ClimatologicalCenter = float2(0.80f, 0.80f);
    Biomes[3].ClimatologicalRadius = float2(0.35f, 0.40f);
    Biomes[3].BaseColor            = float3(0.35f, 0.42f, 0.48f);
    Biomes[3].Roughness            = 0.40f;
    Biomes[3].Metallic             = 0.00f;
    Biomes[3].Specular             = 0.55f;
    Biomes[3].MicroTiling          = 1.8f;
    Biomes[3].NormalStrength       = 1.5f;

    // Geological Strata: Frost White, Deep Cyan Glacial, Tholin Amber
    StrataParams.Frequency      = 0.10f;
    StrataParams.Distortion     = 0.35f;
    StrataParams.ColorTier1     = float3(0.88f, 0.93f, 0.98f); // Compacted Frost
    StrataParams.ColorTier2     = float3(0.38f, 0.62f, 0.78f); // Deep Cryo Ice
    StrataParams.ColorTier3     = float3(0.48f, 0.28f, 0.15f); // Tholin Hydrocarbon
    StrataParams.RoughnessDelta = 0.22f;
    StrataParams.NormalStrength = 0.30f;
}

/**
 * Initializes Volcanic World archetype (Io / Mustafar):
 *   0: Hardened Basalt Crust
 *   1: Yellow/Orange Sulfur Deposition Fields
 *   2: Dark Obsidian Glass Scree
 *   3: Active Magma Vent / Thermal Cracks (Emissive)
 */
void InitVolcanicMasterArchetype(
    out FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    out int BiomeCount,
    out FPlanetaryStrataParameters StrataParams)
{
    BiomeCount = 4;

    // 0: Hardened Basalt Crust
    Biomes[0].ClimatologicalCenter = float2(0.30f, 0.30f);
    Biomes[0].ClimatologicalRadius = float2(0.35f, 0.40f);
    Biomes[0].BaseColor            = float3(0.12f, 0.11f, 0.10f);
    Biomes[0].Roughness            = 0.90f;
    Biomes[0].Metallic             = 0.05f;
    Biomes[0].Specular             = 0.35f;
    Biomes[0].MicroTiling          = 2.0f;
    Biomes[0].NormalStrength       = 1.2f;

    // 1: Yellow/Orange Sulfur Fields
    Biomes[1].ClimatologicalCenter = float2(0.30f, 0.80f);
    Biomes[1].ClimatologicalRadius = float2(0.35f, 0.40f);
    Biomes[1].BaseColor            = float3(0.75f, 0.62f, 0.14f);
    Biomes[1].Roughness            = 0.82f;
    Biomes[1].Metallic             = 0.00f;
    Biomes[1].Specular             = 0.38f;
    Biomes[1].MicroTiling          = 2.5f;
    Biomes[1].NormalStrength       = 0.9f;

    // 2: Dark Obsidian Glass
    Biomes[2].ClimatologicalCenter = float2(0.75f, 0.30f);
    Biomes[2].ClimatologicalRadius = float2(0.35f, 0.40f);
    Biomes[2].BaseColor            = float3(0.04f, 0.04f, 0.05f);
    Biomes[2].Roughness            = 0.15f;
    Biomes[2].Metallic             = 0.00f;
    Biomes[2].Specular             = 0.70f;
    Biomes[2].MicroTiling          = 1.0f;
    Biomes[2].NormalStrength       = 0.8f;

    // 3: Active Magma Vent (Emissive thermal crust)
    Biomes[3].ClimatologicalCenter = float2(0.85f, 0.85f);
    Biomes[3].ClimatologicalRadius = float2(0.25f, 0.30f);
    Biomes[3].BaseColor            = float3(0.30f, 0.05f, 0.02f);
    Biomes[3].Roughness            = 0.60f;
    Biomes[3].Metallic             = 0.00f;
    Biomes[3].Specular             = 0.40f;
    Biomes[3].MicroTiling          = 1.5f;
    Biomes[3].NormalStrength       = 1.0f;

    // Geological Strata: Volcanic Ash, Dark Basalt, Yellow Sulfur Crust
    StrataParams.Frequency      = 0.07f;
    StrataParams.Distortion     = 0.50f;
    StrataParams.ColorTier1     = float3(0.20f, 0.18f, 0.16f); // Volcanic Ash
    StrataParams.ColorTier2     = float3(0.08f, 0.07f, 0.06f); // Vitric Basalt
    StrataParams.ColorTier3     = float3(0.68f, 0.48f, 0.10f); // Sulfur Deposit
    StrataParams.RoughnessDelta = 0.20f;
    StrataParams.NormalStrength = 0.40f;
}

// ============================================================================
// MAIN UNIFIED PLANETARY SURFACE EVALUATION CORE
// ============================================================================

/**
 * Master evaluation core for procedural and triplanar planetary surfaces.
 * Combines analytical Whittaker biomes, dual-octave 3D volume noise (Macro & Meso),
 * sedimentary cliff stratification, height-blended transitions, 2D spherical triplanar
 * near-surface photographic detailing, snow, wetness, magma emission, and Toksvig specular AA.
 */
void EvaluatePlanetaryMasterSurfaceCore(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,        // Secondary procedural meso/macro frequency (symmetrical to MacroFrequency)
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bHasNearDetail,          // 1.0 if 2D near detail textures are active
    in FPlanetaryNearDetailParameters NearDetailParams,
    in float3 InNearSurfaceTexColor,   // Pre-sampled or triplanar surface albedo (Near)
    in float3 InNearSurfaceTexNormal,  // Pre-sampled or triplanar surface normal (Near)
    in float3 InNearRockTexColor,      // Pre-sampled or triplanar rock albedo (Near)
    in float3 InNearRockTexNormal,     // Pre-sampled or triplanar rock normal (Near)
    in float3 InNearSnowTexColor,      // Pre-sampled or triplanar snow albedo (Near)
    in float3 InNearSnowTexNormal,     // Pre-sampled or triplanar snow normal (Near)
    in float  bHasFarDetail,           // 1.0 if 2D far detail textures are active
    in FPlanetaryFarDetailParameters FarDetailParams,
    in float3 InFarSurfaceTexColor,    // Pre-sampled or triplanar surface albedo (Far)
    in float3 InFarSurfaceTexNormal,   // Pre-sampled or triplanar surface normal (Far)
    in float3 InFarRockTexColor,       // Pre-sampled or triplanar rock albedo (Far)
    in float3 InFarRockTexNormal,      // Pre-sampled or triplanar rock normal (Far)
    in float3 InFarSnowTexColor,       // Pre-sampled or triplanar snow albedo (Far)
    in float3 InFarSnowTexNormal,      // Pre-sampled or triplanar snow normal (Far)
    out FPlanetaryMasterOutput OutSurface,
    out float OutTempWarped,
    out float OutHumidityWarped)
{
    // --- 1. LWC Geometric Basis & Tangent Frame ---
    float3 LocalPos;
    float3 RadialNormal;
    float3 GeometryNormal;
    float  AltitudeFromCenter;
    float  CameraDistance;

    ComputePlanetaryMasterGeometry(
        InWorldPos, InPlanetCenter, InPlanetRadius, InMeshWorldNormal, InCameraWorldPos,
        LocalPos, RadialNormal, GeometryNormal, AltitudeFromCenter, CameraDistance);

    // Orthonormal tangent basis on sphere strictly perpendicular to RadialNormal
    float3 T1, T2;
    GetPlanetaryMasterTangentFrame(RadialNormal, T1, T2);

    // --- 2. Camera Distance Continuous LOD & Toksvig Anti-Aliasing ---
    float MacroLOD = saturate(1.0f - (CameraDistance - PLANETARY_MACRO_FADE_START_CM) 
                            / max(PLANETARY_MACRO_FADE_END_CM - PLANETARY_MACRO_FADE_START_CM, 10000.0f));

    // Near-detail activation factor: smooth fade within configurable distance threshold
    float NearDist = max(NearDetailParams.Distance, 100.0f);
    float NearFade = max(NearDetailParams.FadeRange, 10.0f);
    float NearDetailWeight = 0.0f;
    if (bHasNearDetail > 0.5f)
    {
        NearDetailWeight = 1.0f - smoothstep(NearDist - NearFade, NearDist, CameraDistance);
    }

    // Far-detail activation factor: crossfades from NearDetail and fades out to pure procedural macro
    float FarDist = max(FarDetailParams.Distance, NearDist + 1000.0f);
    float FarFade = max(FarDetailParams.FadeRange, 100.0f);
    float FarDetailWeight = 0.0f;
    if (bHasFarDetail > 0.5f)
    {
        float FarEntrance = (bHasNearDetail > 0.5f) ? smoothstep(NearDist - NearFade, NearDist, CameraDistance) : (1.0f - smoothstep(FarDist - FarFade, FarDist, CameraDistance));
        float FarExit = 1.0f - smoothstep(FarDist - FarFade, FarDist, CameraDistance);
        FarDetailWeight = (bHasNearDetail > 0.5f) ? (FarEntrance * FarExit) : FarExit;
    }

    // Toksvig roughness bias to absorb orbital normal variance into microfacet roughness
    float ToksvigBias = saturate((CameraDistance - PLANETARY_MESO_FADE_START_CM) 
                                / (PLANETARY_MESO_FADE_END_CM * 2.0f)) * 0.32f;

    // --- 3. Climatological Inputs & 3D Domain Warping ---
    float AltitudeNorm = saturate(InVertexColor.r);
    float VisualTemp   = saturate(InVertexColor.g);
    float Humidity     = saturate(InVertexColor.b);
    float SurfaceMask  = saturate(InVertexColor.a);

    // 3D Primary Macro Noise Sampling & Tangent Gradient (Symmetrical finite difference)
    float MacroH = 0.5f;
    float MacroFreq = max(InMacroFrequency, 0.000001f);
    float MacroEps  = max(2.0f / MacroFreq * 0.01f, 100.0f); // Scale-proportional finite difference

    float3 MacroGrad = ComputeMasterVolumeSurfaceGradient(
        InVolumeTexture, InVolumeSampler,
        InWorldPos, T1, T2,
        MacroFreq, MacroEps, MacroH);

    // Multi-channel organic domain warping of climate phase space
    float TempWarped     = saturate(VisualTemp + (MacroH - 0.5f) * 0.15f);
    float HumidityWarped = saturate(Humidity   + (MacroGrad.x + MacroGrad.y) * 0.08f);

    OutTempWarped     = TempWarped;
    OutHumidityWarped = HumidityWarped;

    // --- 4. Archetype & Biome Initialization ---
    FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES];
    FPlanetaryStrataParameters StrataParams;
    int BiomeCount = 8;
    int ArchetypeIndex = (int)round(InArchetypeIndex);

    if (ArchetypeIndex == 1)
    {
        InitMarsLikeMasterArchetype(Biomes, BiomeCount, StrataParams);
    }
    else if (ArchetypeIndex == 2)
    {
        InitIceMoonMasterArchetype(Biomes, BiomeCount, StrataParams);
    }
    else if (ArchetypeIndex == 3)
    {
        InitVolcanicMasterArchetype(Biomes, BiomeCount, StrataParams);
    }
    else
    {
        InitEarthLikeMasterArchetype(Biomes, BiomeCount, StrataParams);
    }

    // --- 5. Whittaker Evaluation (Analytical Gaussian RBF) ---
    float3 BiomeColor;
    float  BiomeRoughness;
    float  BiomeMetallic;
    float  BiomeSpecular;
    float  BiomeMicroTiling;
    float  BiomeNormalScale;

    // Core procedural engine: Analytical Gaussian RBF
    EvaluateMasterWhittakerBiomes(
        TempWarped,
        HumidityWarped,
        Biomes,
        BiomeCount,
        3.5f, // Smooth transition sharpness
        BiomeColor,
        BiomeRoughness,
        BiomeMetallic,
        BiomeSpecular,
        BiomeMicroTiling,
        BiomeNormalScale);

    // --- 6. Secondary Procedural Noise Layer (Meso/Macro Relief) ---
    // Evaluates secondary procedural 3D volume noise layer symmetrically to MacroFrequency
    float MesoH = 0.5f;
    float MesoFreq = max(InMicroFrequency, 0.000001f);
    float MesoEps  = max(2.0f / MesoFreq * 0.01f, 20.0f);

    float3 MesoGrad = ComputeMasterVolumeSurfaceGradient(
        InVolumeTexture, InVolumeSampler,
        InWorldPos, T1, T2,
        MesoFreq * BiomeMicroTiling, MesoEps, MesoH);

    // Combined procedural surface gradient (Primary Macro + Secondary Meso)
    float3 ProceduralGradient = (MacroGrad * 0.6f + MesoGrad * (0.4f * BiomeNormalScale)) * MacroLOD;

    // Tangent normal perturbation strictly perpendicular to GeometryNormal
    float EffNormalStrength = InNormalStrength * MacroLOD;
    float3 TangentPerturb = (T1 * dot(ProceduralGradient, T1) + T2 * dot(ProceduralGradient, T2)) * EffNormalStrength;
    float3 PerturbedNormal = normalize(GeometryNormal - TangentPerturb);

    // --- 7. Slope Calculation & Geological Sedimentary Cliff Stratification ---
    float SlopeCos = saturate(dot(RadialNormal, PerturbedNormal));
    float RawSlope = 1.0f - SlopeCos; // 0 on flat ground, 1 on vertical cliffs

    // Perturb slope boundary slightly with 3D noise for natural irregular cliff borders
    float PerturbedSlope = saturate(RawSlope + (MacroH - 0.5f) * 0.20f);

    float HalfFalloff = max(InSlopeCliffFalloff * 0.5f, 0.001f);
    float CliffSlopeWeight = smoothstep(InSlopeCliffThreshold - HalfFalloff, InSlopeCliffThreshold + HalfFalloff, PerturbedSlope);

    // Height-blended transition between flat biome soil and bare cliff rock
    float HeightFlat = saturate(MesoH);
    float HeightCliff = saturate(1.0f - MesoH * 0.6f);
    float CliffMask = ComputeMasterHeightBlend2(
        1.0f - CliffSlopeWeight, HeightFlat,
        CliffSlopeWeight, HeightCliff,
        0.15f);

    // Procedural Sedimentary Strata evaluation on cliffs
    float3 StrataTint;
    float  StrataRoughDelta;
    float  StrataNormOffset;
    float  Strata01;

    EvaluateMasterGeologicalStrata(
        LocalPos, AltitudeFromCenter, MacroH, StrataParams,
        StrataTint, StrataRoughDelta, StrataNormOffset, Strata01);

    // Modulate cliff albedo with geological sedimentary strata
    float3 CliffAlbedo = StrataTint * 1.15f;
    float  CliffRoughness = saturate(0.88f + StrataRoughDelta);

    // Blend flat biome terrain with stratified cliff rock
    float3 BaseAlbedo   = lerp(BiomeColor, CliffAlbedo, CliffMask);
    float  EffRoughness = lerp(BiomeRoughness, CliffRoughness, CliffMask);

    // Add horizontal sedimentary shelf ribbing to the normal on steep cliffs
    if (CliffMask > 0.01f)
    {
        PerturbedNormal = normalize(PerturbedNormal + RadialNormal * (StrataNormOffset * CliffMask * 0.4f));
    }

    // --- 8. Dynamic Snowline & Glaciation (Gravity Slide-Off Physics) ---
    float SnowThreshold = max(InSnowTemperatureThreshold, 0.01f);
    float SnowRaw = saturate((SnowThreshold - TempWarped) / max(SnowThreshold * 0.6f, 0.02f));

    // Slope slide-off damping: gravity prevents snow from sticking to steep cliffs
    float SnowSlopeDamp = smoothstep(0.50f, 0.20f, RawSlope);
    float SnowWeight = SnowRaw * SnowSlopeDamp;

    // Height-blend snow accumulation: snow settles on ridges and plateaus first
    float SnowMask = ComputeMasterHeightBlend2(
        1.0f - SnowWeight, 1.0f - HeightFlat,
        SnowWeight, 0.85f,
        0.18f) * saturate(SnowWeight * 2.0f);

    if (SnowMask > 0.001f)
    {
        float3 SnowAlbedo = float3(0.92f, 0.94f, 0.98f);
        BaseAlbedo    = lerp(BaseAlbedo, SnowAlbedo, SnowMask);
        EffRoughness  = lerp(EffRoughness, 0.65f, SnowMask);
        BiomeMetallic = lerp(BiomeMetallic, 0.0f, SnowMask);
        BiomeSpecular = lerp(BiomeSpecular, 0.50f, SnowMask);
    }

    // --- 9. Multi-Tier 2D Photographic Triplanar Detail Layers (Near & Far) ---
    float TotalDetailWeight = NearDetailWeight + FarDetailWeight;
    if (TotalDetailWeight > 0.001f)
    {
        // Compute relative blend weight between Near and Far details
        float NearWeightNorm = NearDetailWeight / max(TotalDetailWeight, 0.0001f);
        float FarWeightNorm  = FarDetailWeight  / max(TotalDetailWeight, 0.0001f);

        // 1. Composite Flat Surface, Rock, and Snow textures blending Near and Far tiers
        float3 BlendedSurfaceColor = InNearSurfaceTexColor * NearWeightNorm + InFarSurfaceTexColor * FarWeightNorm;
        float3 BlendedSurfaceNormal = normalize(InNearSurfaceTexNormal * NearWeightNorm + InFarSurfaceTexNormal * FarWeightNorm);

        float3 BlendedRockColor = InNearRockTexColor * NearWeightNorm + InFarRockTexColor * FarWeightNorm;
        float3 BlendedRockNormal = normalize(InNearRockTexNormal * NearWeightNorm + InFarRockTexNormal * FarWeightNorm);

        float3 BlendedSnowColor = InNearSnowTexColor * NearWeightNorm + InFarSnowTexColor * FarWeightNorm;
        float3 BlendedSnowNormal = normalize(InNearSnowTexNormal * NearWeightNorm + InFarSnowTexNormal * FarWeightNorm);

        // 2. Blend Surface with Rock based on CliffMask
        float3 BlendedTexAlbedo = lerp(BlendedSurfaceColor, BlendedRockColor, CliffMask);
        float3 BlendedTexNormal = normalize(lerp(BlendedSurfaceNormal, BlendedRockNormal, CliffMask));

        // 3. Blend with Snow based on SnowMask
        if (SnowMask > 0.001f)
        {
            BlendedTexAlbedo = lerp(BlendedTexAlbedo, BlendedSnowColor, SnowMask);
            BlendedTexNormal = normalize(lerp(BlendedTexNormal, BlendedSnowNormal, SnowMask));
        }

        // 4. Effective blend factors for color and normal strength
        float EffColorBlend = saturate(NearDetailParams.ColorBlend * NearWeightNorm + FarDetailParams.ColorBlend * FarWeightNorm);
        float EffNormalStr  = saturate(NearDetailParams.NormalStrength * NearWeightNorm + FarDetailParams.NormalStrength * FarWeightNorm);

        // 5. Modulate Base Terrain Color with Photographic Detail
        float3 ModulatedAlbedo = BaseAlbedo * BlendedTexAlbedo * 2.0f;
        float3 DirectAlbedo    = BlendedTexAlbedo;
        float3 CompositeDetail = lerp(ModulatedAlbedo, DirectAlbedo, 0.35f);

        float FinalDetailWeight = saturate(TotalDetailWeight);
        BaseAlbedo = lerp(BaseAlbedo, CompositeDetail, FinalDetailWeight * EffColorBlend);

        // 6. Perturb World Normal with High-Res Detail Normal Map
        PerturbedNormal = normalize(lerp(PerturbedNormal, BlendedTexNormal, FinalDetailWeight * EffNormalStr));
    }

    // --- 10. Moisture, Wetness & Water Puddle Physics ---
    float WetnessMask = 0.0f;
    if (InWetnessIntensity > 0.01f)
    {
        float PuddleDepression = saturate(1.0f - RawSlope * 1.5f);
        WetnessMask = saturate((Humidity - 0.42f) / 0.50f) * PuddleDepression * InWetnessIntensity;

        WetnessMask *= (1.0f - SnowMask) * (1.0f - CliffMask * 0.75f);
        BaseAlbedo *= (1.0f - 0.35f * WetnessMask);
        EffRoughness = lerp(EffRoughness, 0.03f, WetnessMask * 0.90f);
        BiomeSpecular = lerp(BiomeSpecular, 0.55f, WetnessMask);
    }

    // --- 11. Toksvig Specular Anti-Aliasing Integration ---
    float FinalRoughness = saturate(sqrt(EffRoughness * EffRoughness + ToksvigBias * ToksvigBias));

    // --- 12. Volcanic / Thermal Emission ---
    float3 Emissive = float3(0.0f, 0.0f, 0.0f);
    if (ArchetypeIndex == 3) // Volcanic world
    {
        float MagmaMask = saturate((0.32f - AltitudeNorm) / 0.20f) * saturate(1.0f - RawSlope * 1.2f);
        MagmaMask *= saturate(1.0f - MacroH * 1.6f);

        float3 MagmaHDR = float3(3.0f, 0.40f, 0.02f);
        Emissive = MagmaHDR * (MagmaMask * 5.0f);
        BaseAlbedo = lerp(BaseAlbedo, float3(0.04f, 0.02f, 0.01f), MagmaMask);
    }

    // --- 13. Pack Output Struct ---
    OutSurface.BaseColor        = BaseAlbedo;
    OutSurface.WorldNormal      = PerturbedNormal;
    OutSurface.Roughness        = FinalRoughness;
    OutSurface.Metallic         = BiomeMetallic;
    OutSurface.Specular         = BiomeSpecular;
    OutSurface.AmbientOcclusion = lerp(0.85f, 1.0f, MacroH);
    OutSurface.Emissive         = Emissive;
    OutSurface.SnowMask         = SnowMask;
    OutSurface.SlopeMask        = CliffMask;
    OutSurface.WetnessMask      = WetnessMask;
    OutSurface.StrataMask       = Strata01;
    OutSurface.LODFactor        = MacroLOD;
    OutSurface.NearDetailWeight = NearDetailWeight;
    OutSurface.FarDetailWeight  = FarDetailWeight;
}

// Backward-compatible core overload (NearDetail only)
void EvaluatePlanetaryMasterSurfaceCore(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bHasNearDetail,
    in FPlanetaryNearDetailParameters NearDetailParams,
    in float3 InNearSurfaceTexColor,
    in float3 InNearSurfaceTexNormal,
    in float3 InNearRockTexColor,
    in float3 InNearRockTexNormal,
    in float3 InNearSnowTexColor,
    in float3 InNearSnowTexNormal,
    out FPlanetaryMasterOutput OutSurface,
    out float OutTempWarped,
    out float OutHumidityWarped)
{
    FPlanetaryFarDetailParameters DummyFarParams;
    DummyFarParams.Distance = 0.0f;
    DummyFarParams.FadeRange = 1.0f;
    DummyFarParams.SurfaceTiling = 1.0f;
    DummyFarParams.RockTiling = 1.0f;
    DummyFarParams.SnowTiling = 1.0f;
    DummyFarParams.ColorBlend = 0.0f;
    DummyFarParams.NormalStrength = 0.0f;
    DummyFarParams.TriplanarSharpness = 4.0f;

    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bHasNearDetail, NearDetailParams,
        InNearSurfaceTexColor, InNearSurfaceTexNormal,
        InNearRockTexColor, InNearRockTexNormal,
        InNearSnowTexColor, InNearSnowTexNormal,
        0.0f, DummyFarParams,
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        OutSurface, OutTempWarped, OutHumidityWarped);
}

// ============================================================================
// CONVENIENCE EVALUATION INTERFACES
// ============================================================================

// 1. Procedural-Only Evaluation (No 2D Near Textures)
void EvaluatePlanetaryMasterSurface(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    out FPlanetaryMasterOutput OutSurface)
{
    float DummyT, DummyH;
    FPlanetaryNearDetailParameters DummyParams;
    DummyParams.Distance = 0.0f;
    DummyParams.FadeRange = 1.0f;
    DummyParams.SurfaceTiling = 1.0f;
    DummyParams.RockTiling = 1.0f;
    DummyParams.SnowTiling = 1.0f;
    DummyParams.ColorBlend = 0.0f;
    DummyParams.NormalStrength = 0.0f;
    DummyParams.TriplanarSharpness = 4.0f;

    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        0.0f, DummyParams,
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        OutSurface, DummyT, DummyH);
}

// 2. Procedural + Optional 2D LUT Override
void EvaluatePlanetaryMasterSurface(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bUseLUTOverride,
    in Texture2D InOptionalWhittakerLUT,
    in SamplerState InOptionalWhittakerLUTSampler,
    out FPlanetaryMasterOutput OutSurface)
{
    float TempWarped, HumWarped;
    FPlanetaryNearDetailParameters DummyParams;
    DummyParams.Distance = 0.0f;
    DummyParams.FadeRange = 1.0f;
    DummyParams.SurfaceTiling = 1.0f;
    DummyParams.RockTiling = 1.0f;
    DummyParams.SnowTiling = 1.0f;
    DummyParams.ColorBlend = 0.0f;
    DummyParams.NormalStrength = 0.0f;
    DummyParams.TriplanarSharpness = 4.0f;

    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        0.0f, DummyParams,
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        OutSurface, TempWarped, HumWarped);

    if (bUseLUTOverride > 0.5f)
    {
        float2 LUTCoords = float2(TempWarped, 1.0f - HumWarped);
        float3 LUTColor = InOptionalWhittakerLUT.SampleLevel(InOptionalWhittakerLUTSampler, LUTCoords, 0.0f).rgb;
        OutSurface.BaseColor = lerp(OutSurface.BaseColor, LUTColor, 0.85f);
    }
}

// 3. Full Master Evaluation with In-Shader 2D Spherical Triplanar Textures & Normal Maps (Near & Far detail tiers, 6 Individual Samplers)
void EvaluatePlanetaryMasterSurfaceWithTriplanar(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bUseLUTOverride,
    in Texture2D InOptionalWhittakerLUT,
    in SamplerState InOptionalWhittakerLUTSampler,
    in Texture2D InNearSurfaceAlbedo,
    in SamplerState InNearSurfaceAlbedoSampler,
    in Texture2D InNearSurfaceNormal,
    in SamplerState InNearSurfaceNormalSampler,
    in Texture2D InNearRockAlbedo,
    in SamplerState InNearRockAlbedoSampler,
    in Texture2D InNearRockNormal,
    in SamplerState InNearRockNormalSampler,
    in Texture2D InNearSnowAlbedo,
    in SamplerState InNearSnowAlbedoSampler,
    in Texture2D InNearSnowNormal,
    in SamplerState InNearSnowNormalSampler,
    in float  InNearDetailDistance,
    in float  InNearDetailFadeRange,
    in float  InNearDetailTiling,
    in float  InNearDetailRockTiling,
    in float  InNearDetailSnowTiling,
    in float  InNearDetailColorBlend,
    in float  InNearDetailNormalStrength,
    in float  InFarDetailDistance,
    in float  InFarDetailFadeRange,
    in float  InFarDetailTiling,
    in float  InFarDetailRockTiling,
    in float  InFarDetailSnowTiling,
    in float  InFarDetailColorBlend,
    in float  InFarDetailNormalStrength,
    out FPlanetaryMasterOutput OutSurface)
{
    float3 LocalPos = InWorldPos - InPlanetCenter;
    float DistFromCenter = length(LocalPos);
    float3 RadialNormal = LocalPos / max(DistFromCenter, 1.0f);
    float3 GeometryNormal = (length(InMeshWorldNormal) > 0.01f) ? normalize(InMeshWorldNormal) : RadialNormal;

    float CamLenSq = dot(InCameraWorldPos, InCameraWorldPos);
    float CameraDistance = (CamLenSq > 100.0f) ? length(InWorldPos - InCameraWorldPos) : 100000.0f;

    // Near Parameters
    FPlanetaryNearDetailParameters NearParams;
    NearParams.Distance = InNearDetailDistance > 10.0f ? InNearDetailDistance : PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM;
    NearParams.FadeRange = InNearDetailFadeRange > 5.0f ? InNearDetailFadeRange : PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM;
    NearParams.SurfaceTiling = max(InNearDetailTiling, 0.00001f);
    NearParams.RockTiling = max(InNearDetailRockTiling, 0.00001f);
    NearParams.SnowTiling = max(InNearDetailSnowTiling, 0.00001f);
    NearParams.ColorBlend = saturate(InNearDetailColorBlend);
    NearParams.NormalStrength = max(InNearDetailNormalStrength, 0.0f);
    NearParams.TriplanarSharpness = 4.0f;

    // Far Parameters
    FPlanetaryFarDetailParameters FarParams;
    FarParams.Distance = InFarDetailDistance > NearParams.Distance ? InFarDetailDistance : PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM;
    FarParams.FadeRange = InFarDetailFadeRange > 5.0f ? InFarDetailFadeRange : PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM;
    FarParams.SurfaceTiling = max(InFarDetailTiling, 0.000001f);
    FarParams.RockTiling = max(InFarDetailRockTiling, 0.000001f);
    FarParams.SnowTiling = max(InFarDetailSnowTiling, 0.000001f);
    FarParams.ColorBlend = saturate(InFarDetailColorBlend);
    FarParams.NormalStrength = max(InFarDetailNormalStrength, 0.0f);
    FarParams.TriplanarSharpness = 4.0f;

    float NearWeight = 1.0f - smoothstep(NearParams.Distance - NearParams.FadeRange, NearParams.Distance, CameraDistance);
    float FarEntrance = smoothstep(NearParams.Distance - NearParams.FadeRange, NearParams.Distance, CameraDistance);
    float FarExit = 1.0f - smoothstep(FarParams.Distance - FarParams.FadeRange, FarParams.Distance, CameraDistance);
    float FarWeight = FarEntrance * FarExit;

    // 1. Near Triplanar Sampling (Only when NearWeight > 0.001)
    float3 NearSurfaceTexCol  = float3(1.0f, 1.0f, 1.0f);
    float3 NearSurfaceTexNorm = GeometryNormal;
    float3 NearRockTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 NearRockTexNorm    = GeometryNormal;
    float3 NearSnowTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 NearSnowTexNorm    = GeometryNormal;

    if (NearWeight > 0.001f)
    {
        NearSurfaceTexCol  = SampleMasterTriplanarAlbedo(InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, NearParams.SurfaceTiling, 4.0f);
        NearSurfaceTexNorm = SampleMasterTriplanarNormal(InNearSurfaceNormal, InNearSurfaceNormalSampler, LocalPos, GeometryNormal, NearParams.SurfaceTiling, 4.0f, NearParams.NormalStrength);

        NearRockTexCol     = SampleMasterTriplanarAlbedo(InNearRockAlbedo, InNearRockAlbedoSampler, LocalPos, GeometryNormal, NearParams.RockTiling, 4.0f);
        NearRockTexNorm    = SampleMasterTriplanarNormal(InNearRockNormal, InNearRockNormalSampler, LocalPos, GeometryNormal, NearParams.RockTiling, 4.0f, NearParams.NormalStrength);

        NearSnowTexCol     = SampleMasterTriplanarAlbedo(InNearSnowAlbedo, InNearSnowAlbedoSampler, LocalPos, GeometryNormal, NearParams.SnowTiling, 4.0f);
        NearSnowTexNorm    = SampleMasterTriplanarNormal(InNearSnowNormal, InNearSnowNormalSampler, LocalPos, GeometryNormal, NearParams.SnowTiling, 4.0f, NearParams.NormalStrength);
    }

    // 2. Far Triplanar Sampling (Only when FarWeight > 0.001 - Reusing the SAME Texture Objects!)
    float3 FarSurfaceTexCol  = float3(1.0f, 1.0f, 1.0f);
    float3 FarSurfaceTexNorm = GeometryNormal;
    float3 FarRockTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 FarRockTexNorm    = GeometryNormal;
    float3 FarSnowTexCol     = float3(1.0f, 1.0f, 1.0f);
    float3 FarSnowTexNorm    = GeometryNormal;

    if (FarWeight > 0.001f)
    {
        FarSurfaceTexCol  = SampleMasterTriplanarAlbedo(InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, LocalPos, GeometryNormal, FarParams.SurfaceTiling, 4.0f);
        FarSurfaceTexNorm = SampleMasterTriplanarNormal(InNearSurfaceNormal, InNearSurfaceNormalSampler, LocalPos, GeometryNormal, FarParams.SurfaceTiling, 4.0f, FarParams.NormalStrength);

        FarRockTexCol     = SampleMasterTriplanarAlbedo(InNearRockAlbedo, InNearRockAlbedoSampler, LocalPos, GeometryNormal, FarParams.RockTiling, 4.0f);
        FarRockTexNorm    = SampleMasterTriplanarNormal(InNearRockNormal, InNearRockNormalSampler, LocalPos, GeometryNormal, FarParams.RockTiling, 4.0f, FarParams.NormalStrength);

        FarSnowTexCol     = SampleMasterTriplanarAlbedo(InNearSnowAlbedo, InNearSnowAlbedoSampler, LocalPos, GeometryNormal, FarParams.SnowTiling, 4.0f);
        FarSnowTexNorm    = SampleMasterTriplanarNormal(InNearSnowNormal, InNearSnowNormalSampler, LocalPos, GeometryNormal, FarParams.SnowTiling, 4.0f, FarParams.NormalStrength);
    }

    float TempWarped, HumWarped;
    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        1.0f, NearParams,
        NearSurfaceTexCol, NearSurfaceTexNorm,
        NearRockTexCol, NearRockTexNorm,
        NearSnowTexCol, NearSnowTexNorm,
        1.0f, FarParams,
        FarSurfaceTexCol, FarSurfaceTexNorm,
        FarRockTexCol, FarRockTexNorm,
        FarSnowTexCol, FarSnowTexNorm,
        OutSurface, TempWarped, HumWarped);

    if (bUseLUTOverride > 0.5f)
    {
        float2 LUTCoords = float2(TempWarped, 1.0f - HumWarped);
        float3 LUTColor = InOptionalWhittakerLUT.SampleLevel(InOptionalWhittakerLUTSampler, LUTCoords, 0.0f).rgb;
        OutSurface.BaseColor = lerp(OutSurface.BaseColor, LUTColor, 0.85f);
    }
}

// 4. Full Master Evaluation with In-Shader 2D Spherical Triplanar Textures (Near & Far tiers, 3 Shared Albedo Samplers)
void EvaluatePlanetaryMasterSurfaceWithTriplanar(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bUseLUTOverride,
    in Texture2D InOptionalWhittakerLUT,
    in SamplerState InOptionalWhittakerLUTSampler,
    in Texture2D InNearSurfaceAlbedo,
    in Texture2D InNearSurfaceNormal,
    in SamplerState InNearSurfaceAlbedoSampler,
    in Texture2D InNearRockAlbedo,
    in Texture2D InNearRockNormal,
    in SamplerState InNearRockAlbedoSampler,
    in Texture2D InNearSnowAlbedo,
    in Texture2D InNearSnowNormal,
    in SamplerState InNearSnowAlbedoSampler,
    in float  InNearDetailDistance,
    in float  InNearDetailFadeRange,
    in float  InNearDetailTiling,
    in float  InNearDetailRockTiling,
    in float  InNearDetailSnowTiling,
    in float  InNearDetailColorBlend,
    in float  InNearDetailNormalStrength,
    in float  InFarDetailDistance,
    in float  InFarDetailFadeRange,
    in float  InFarDetailTiling,
    in float  InFarDetailRockTiling,
    in float  InFarDetailSnowTiling,
    in float  InFarDetailColorBlend,
    in float  InFarDetailNormalStrength,
    out FPlanetaryMasterOutput OutSurface)
{
    EvaluatePlanetaryMasterSurfaceWithTriplanar(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos, InVertexColor, InMeshWorldNormal,
        InVolumeTexture, InVolumeSampler, InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bUseLUTOverride, InOptionalWhittakerLUT, InOptionalWhittakerLUTSampler,
        InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, InNearSurfaceNormal, InNearSurfaceAlbedoSampler,
        InNearRockAlbedo, InNearRockAlbedoSampler, InNearRockNormal, InNearRockAlbedoSampler,
        InNearSnowAlbedo, InNearSnowAlbedoSampler, InNearSnowNormal, InNearSnowAlbedoSampler,
        InNearDetailDistance, InNearDetailFadeRange, InNearDetailTiling, InNearDetailRockTiling, InNearDetailSnowTiling,
        InNearDetailColorBlend, InNearDetailNormalStrength,
        InFarDetailDistance, InFarDetailFadeRange, InFarDetailTiling, InFarDetailRockTiling, InFarDetailSnowTiling,
        InFarDetailColorBlend, InFarDetailNormalStrength,
        OutSurface);
}

// Backward-compatible overload (NearDetail only, 6 individual samplers)
void EvaluatePlanetaryMasterSurfaceWithTriplanar(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bUseLUTOverride,
    in Texture2D InOptionalWhittakerLUT,
    in SamplerState InOptionalWhittakerLUTSampler,
    in Texture2D InNearSurfaceAlbedo,
    in SamplerState InNearSurfaceAlbedoSampler,
    in Texture2D InNearSurfaceNormal,
    in SamplerState InNearSurfaceNormalSampler,
    in Texture2D InNearRockAlbedo,
    in SamplerState InNearRockAlbedoSampler,
    in Texture2D InNearRockNormal,
    in SamplerState InNearRockNormalSampler,
    in Texture2D InNearSnowAlbedo,
    in SamplerState InNearSnowAlbedoSampler,
    in Texture2D InNearSnowNormal,
    in SamplerState InNearSnowNormalSampler,
    in float  InNearDetailDistance,
    in float  InNearDetailFadeRange,
    in float  InNearDetailTiling,
    in float  InNearDetailRockTiling,
    in float  InNearDetailSnowTiling,
    in float  InNearDetailColorBlend,
    in float  InNearDetailNormalStrength,
    out FPlanetaryMasterOutput OutSurface)
{
    float NearDist = InNearDetailDistance > 10.0f ? InNearDetailDistance : PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM;
    float NearFade = InNearDetailFadeRange > 5.0f ? InNearDetailFadeRange : PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM;

    EvaluatePlanetaryMasterSurfaceWithTriplanar(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos, InVertexColor, InMeshWorldNormal,
        InVolumeTexture, InVolumeSampler, InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bUseLUTOverride, InOptionalWhittakerLUT, InOptionalWhittakerLUTSampler,
        InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, InNearSurfaceNormal, InNearSurfaceNormalSampler,
        InNearRockAlbedo, InNearRockAlbedoSampler, InNearRockNormal, InNearRockNormalSampler,
        InNearSnowAlbedo, InNearSnowAlbedoSampler, InNearSnowNormal, InNearSnowNormalSampler,
        NearDist, NearFade, InNearDetailTiling, InNearDetailRockTiling, InNearDetailSnowTiling,
        InNearDetailColorBlend, InNearDetailNormalStrength,
        PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM, PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM,
        InNearDetailTiling * 0.1f, InNearDetailRockTiling * 0.1f, InNearDetailSnowTiling * 0.1f,
        InNearDetailColorBlend * 0.7f, InNearDetailNormalStrength * 0.6f,
        OutSurface);
}

// Backward-compatible overload (NearDetail only, 3 shared samplers)
void EvaluatePlanetaryMasterSurfaceWithTriplanar(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in float  InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float  InSlopeCliffThreshold,
    in float  InSlopeCliffFalloff,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    in float  bUseLUTOverride,
    in Texture2D InOptionalWhittakerLUT,
    in SamplerState InOptionalWhittakerLUTSampler,
    in Texture2D InNearSurfaceAlbedo,
    in Texture2D InNearSurfaceNormal,
    in SamplerState InNearSurfaceAlbedoSampler,
    in Texture2D InNearRockAlbedo,
    in Texture2D InNearRockNormal,
    in SamplerState InNearRockAlbedoSampler,
    in Texture2D InNearSnowAlbedo,
    in Texture2D InNearSnowNormal,
    in SamplerState InNearSnowAlbedoSampler,
    in float  InNearDetailDistance,
    in float  InNearDetailFadeRange,
    in float  InNearDetailTiling,
    in float  InNearDetailRockTiling,
    in float  InNearDetailSnowTiling,
    in float  InNearDetailColorBlend,
    in float  InNearDetailNormalStrength,
    out FPlanetaryMasterOutput OutSurface)
{
    EvaluatePlanetaryMasterSurfaceWithTriplanar(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos, InVertexColor, InMeshWorldNormal,
        InVolumeTexture, InVolumeSampler, InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        bUseLUTOverride, InOptionalWhittakerLUT, InOptionalWhittakerLUTSampler,
        InNearSurfaceAlbedo, InNearSurfaceAlbedoSampler, InNearSurfaceNormal, InNearSurfaceAlbedoSampler,
        InNearRockAlbedo, InNearRockAlbedoSampler, InNearRockNormal, InNearRockAlbedoSampler,
        InNearSnowAlbedo, InNearSnowAlbedoSampler, InNearSnowNormal, InNearSnowAlbedoSampler,
        InNearDetailDistance, InNearDetailFadeRange, InNearDetailTiling, InNearDetailRockTiling, InNearDetailSnowTiling,
        InNearDetailColorBlend, InNearDetailNormalStrength, OutSurface);
}

// ============================================================================
// MODULAR ENTRY POINTS FOR UNREAL ENGINE 5 MATERIAL GRAPH
// ============================================================================

/**
 * Lightweight Modular Evaluator:
 * Returns float4(WarpedTemp, WarpedHum, CliffSlope, Strata01) for graph-based logic.
 */
float4 EvaluatePlanetaryMasterCoordinates(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InMacroFrequency,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InStrataFrequency,
    float  InStrataDistortion)
{
    float3 LocalPos = InWorldPos - InPlanetCenter;
    float DistFromCenter = length(LocalPos);
    float3 RadialNormal = LocalPos / max(DistFromCenter, 1.0f);
    float3 GeometryNormal = (length(InMeshWorldNormal) > 0.01f) ? normalize(InMeshWorldNormal) : RadialNormal;
    float AltitudeFromCenter = DistFromCenter - InPlanetRadius;

    float3 T1, T2;
    GetPlanetaryMasterTangentFrame(RadialNormal, T1, T2);

    float MacroH = 0.5f;
    float3 MacroGrad = ComputeMasterVolumeSurfaceGradient(
        InVolumeTexture, InVolumeSampler,
        InWorldPos, T1, T2,
        max(InMacroFrequency, 0.000001f), 200.0f, MacroH);

    float TempWarped = saturate(InVertexColor.g + (MacroH - 0.5f) * 0.15f);
    float HumWarped  = saturate(InVertexColor.b + (MacroGrad.x + MacroGrad.y) * 0.08f);

    float SlopeCos = saturate(dot(RadialNormal, GeometryNormal));
    float RawSlope = 1.0f - SlopeCos;
    float HalfFalloff = max(InSlopeCliffFalloff * 0.5f, 0.001f);
    float CliffSlope = smoothstep(InSlopeCliffThreshold - HalfFalloff, InSlopeCliffThreshold + HalfFalloff, RawSlope);

    float BaseCoord = (AltitudeFromCenter * 0.01f) * max(InStrataFrequency, 0.0001f);
    float DistortedCoord = BaseCoord + (MacroH * 2.0f - 1.0f) * InStrataDistortion;
    float Strata01 = (sin(DistortedCoord) + 0.5f * sin(DistortedCoord * 2.718f + 1.4f)) * 0.33f + 0.5f;

    return float4(TempWarped, HumWarped, CliffSlope, saturate(Strata01));
}

float4 EvaluatePlanetaryMasterCoordinates(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InMacroFrequency,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InStrataFrequency,
    float  InStrataDistortion)
{
    return EvaluatePlanetaryMasterCoordinates(
        InWorldPos, InPlanetCenter, InPlanetRadius, float4(InVertexColor, 1.0f), InMeshWorldNormal,
        InVolumeTexture, InVolumeSampler, InMacroFrequency, InSlopeCliffThreshold, InSlopeCliffFalloff,
        InStrataFrequency, InStrataDistortion);
}

// --- Packed Diffuse & Roughness ---
float4 EvaluatePlanetaryMasterPackedDiffuseRoughness(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetaryMasterOutput OutSurface;
    EvaluatePlanetaryMasterSurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return float4(OutSurface.BaseColor, OutSurface.Roughness);
}

