// --- C. PREALIGNED WORLD-ALIGNED EXTERNAL INPUT OVERLOADS ---
float4 EvaluatePlanetaryMasterFullWithPrealignedTextures(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float3 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity,
    float  bUseLUTOverride,
    Texture2D InOptionalWhittakerLUT,
    SamplerState InOptionalWhittakerLUTSampler,
    float3 InPrealignedSurfaceColor,
    float3 InPrealignedSurfaceNormal,
    float3 InPrealignedRockColor,
    float3 InPrealignedRockNormal,
    float3 InPrealignedSnowColor,
    float3 InPrealignedSnowNormal,
    float  InNearDetailDistance,
    float  InNearDetailFadeRange,
    float  InNearDetailColorBlend,
    float  InNearDetailNormalStrength,
    out float3 OutWorldNormal,
    out float  OutEmissive,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutAO,
    out float4 OutMasks)
{
    FPlanetaryNearDetailParameters NearParams;
    NearParams.Distance = InNearDetailDistance > 10.0f ? InNearDetailDistance : PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM;
    NearParams.FadeRange = InNearDetailFadeRange > 5.0f ? InNearDetailFadeRange : PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM;
    NearParams.SurfaceTiling = 1.0f;
    NearParams.RockTiling = 1.0f;
    NearParams.SnowTiling = 1.0f;
    NearParams.ColorBlend = saturate(InNearDetailColorBlend);
    NearParams.NormalStrength = max(InNearDetailNormalStrength, 0.0f);
    NearParams.TriplanarSharpness = 4.0f;

    FPlanetaryFarDetailParameters FarParams;
    FarParams.Distance = PLANETARY_FAR_DETAIL_DEFAULT_DIST_CM;
    FarParams.FadeRange = PLANETARY_FAR_DETAIL_DEFAULT_FADE_CM;
    FarParams.SurfaceTiling = 1.0f;
    FarParams.RockTiling = 1.0f;
    FarParams.SnowTiling = 1.0f;
    FarParams.ColorBlend = saturate(InNearDetailColorBlend * 0.7f);
    FarParams.NormalStrength = max(InNearDetailNormalStrength * 0.6f, 0.0f);
    FarParams.TriplanarSharpness = 4.0f;

    FPlanetaryMasterOutput OutSurface;
    float TempWarped, HumWarped;

    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        float4(InVertexColor, 1.0f), InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        1.0f, NearParams,
        InPrealignedSurfaceColor, InPrealignedSurfaceNormal,
        InPrealignedRockColor, InPrealignedRockNormal,
        InPrealignedSnowColor, InPrealignedSnowNormal,
        0.0f, FarParams,
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        float3(1, 1, 1), float3(0, 0, 1),
        OutSurface, TempWarped, HumWarped);

    if (bUseLUTOverride > 0.5f)
    {
        float2 LUTCoords = float2(TempWarped, 1.0f - HumWarped);
        float3 LUTColor = InOptionalWhittakerLUT.SampleLevel(InOptionalWhittakerLUTSampler, LUTCoords, 0.0f).rgb;
        OutSurface.BaseColor = lerp(OutSurface.BaseColor, LUTColor, 0.85f);
    }

    OutWorldNormal = OutSurface.WorldNormal;
    OutEmissive    = max(OutSurface.Emissive.r, max(OutSurface.Emissive.g, OutSurface.Emissive.b));
    OutMetallic    = OutSurface.Metallic;
    OutSpecular    = OutSurface.Specular;
    OutAO          = OutSurface.AmbientOcclusion;
    OutMasks       = float4(OutSurface.SnowMask, OutSurface.SlopeMask, OutSurface.WetnessMask, OutSurface.StrataMask);

    return float4(OutSurface.BaseColor, OutSurface.Roughness);
}

// 4. Overload accepting pre-projected / WorldAligned External Inputs (for users preferring node-based projection)
float4 EvaluatePlanetaryMasterFullWithPrealignedTextures(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float3 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    float  InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float  InSlopeCliffThreshold,
    float  InSlopeCliffFalloff,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity,
    float  bUseLUTOverride,
    Texture2D InOptionalWhittakerLUT,
    SamplerState InOptionalWhittakerLUTSampler,
    float3 InPrealignedSurfaceColor,
    float3 InPrealignedSurfaceNormal,
    float3 InPrealignedRockColor,
    float3 InPrealignedRockNormal,
    float3 InPrealignedSnowColor,
    float3 InPrealignedSnowNormal,
    float  InNearDetailDistance,
    float  InNearDetailFadeRange,
    float  InNearDetailColorBlend,
    float  InNearDetailNormalStrength,
    out float3 OutWorldNormal,
    out float  OutEmissive,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutAO,
    out float4 OutMasks)
{
    FPlanetaryNearDetailParameters NearParams;
    NearParams.Distance = InNearDetailDistance > 10.0f ? InNearDetailDistance : PLANETARY_NEAR_DETAIL_DEFAULT_DIST_CM;
    NearParams.FadeRange = InNearDetailFadeRange > 5.0f ? InNearDetailFadeRange : PLANETARY_NEAR_DETAIL_DEFAULT_FADE_CM;
    NearParams.SurfaceTiling = 1.0f;
    NearParams.RockTiling = 1.0f;
    NearParams.SnowTiling = 1.0f;
    NearParams.ColorBlend = saturate(InNearDetailColorBlend);
    NearParams.NormalStrength = max(InNearDetailNormalStrength, 0.0f);
    NearParams.TriplanarSharpness = 4.0f;

    FPlanetaryMasterOutput OutSurface;
    float TempWarped, HumWarped;

    EvaluatePlanetaryMasterSurfaceCore(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        float4(InVertexColor, 1.0f), InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffThreshold, InSlopeCliffFalloff, InSnowTemperatureThreshold, InWetnessIntensity,
        1.0f, NearParams,
        InPrealignedSurfaceColor, InPrealignedSurfaceNormal,
        InPrealignedRockColor, InPrealignedRockNormal,
        InPrealignedSnowColor, InPrealignedSnowNormal,
        OutSurface, TempWarped, HumWarped);

    if (bUseLUTOverride > 0.5f)
    {
        float2 LUTCoords = float2(TempWarped, 1.0f - HumWarped);
        float3 LUTColor = InOptionalWhittakerLUT.SampleLevel(InOptionalWhittakerLUTSampler, LUTCoords, 0.0f).rgb;
        OutSurface.BaseColor = lerp(OutSurface.BaseColor, LUTColor, 0.85f);
    }

    OutWorldNormal = OutSurface.WorldNormal;
    OutEmissive    = max(OutSurface.Emissive.r, max(OutSurface.Emissive.g, OutSurface.Emissive.b));
    OutMetallic    = OutSurface.Metallic;
    OutSpecular    = OutSurface.Specular;
    OutAO          = OutSurface.AmbientOcclusion;
    OutMasks       = float4(OutSurface.SnowMask, OutSurface.SlopeMask, OutSurface.WetnessMask, OutSurface.StrataMask);

    return float4(OutSurface.BaseColor, OutSurface.Roughness);
}

