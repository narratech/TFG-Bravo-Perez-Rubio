float3 EvaluateOceanGerstner(
    float3 WorldPos,
    float3 PlanetCenter,
    float  PlanetRadius,
    float  Time,
    float  WaveHeight,
    float  WaveLength,
    float  WaveSpeed,
    float  WaveSteepness,
    float  WaveChop,
    float4 WindDirection,
    float3 CameraPos,
    float  WaveCount,
    float  WaveSpread,
    out float3 OutNormal,
    out float  OutRoughnessBias)
{
    return EvaluateOceanArtist(
        WorldPos, PlanetCenter, PlanetRadius, Time,
        WaveHeight, WaveLength, WaveSpeed, WaveSteepness, WaveChop,
        WindDirection.xyz, CameraPos,
        WaveCount, WaveSpread,
        OutNormal, OutRoughnessBias);
}

float3 EvaluateOceanGerstner(
    float3 WorldPos,
    float3 PlanetCenter,
    float  PlanetRadius,
    float  Time,
    float  WaveHeight,
    float  WaveLength,
    float  WaveSpeed,
    float  WaveSteepness,
    float  WaveChop,
    float4 WindDirection,
    float3 CameraPos,
    out float3 OutNormal,
    out float  OutRoughnessBias)
{
    return EvaluateOceanArtist(
        WorldPos, PlanetCenter, PlanetRadius, Time,
        WaveHeight, WaveLength, WaveSpeed, WaveSteepness, WaveChop,
        WindDirection.xyz, CameraPos,
        12.0f, 1.0f,
        OutNormal, OutRoughnessBias);
}
