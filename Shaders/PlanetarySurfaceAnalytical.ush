// ============================================================================
// MAIN PLANETARY SURFACE EVALUATION
// ============================================================================

/**
 * Main evaluation function for procedural planetary surfaces.
 *
 * @param InWorldPos              - Pixel absolute world position (cm)
 * @param InPlanetCenter          - Planet center in world space (cm)
 * @param InPlanetRadius          - Planet radius in cm
 * @param InCameraWorldPos        - Main camera world position (cm)
 * @param InVertexColor           - Vertex Color (R: AltNorm, G: VisTemp, B: Humidity, A: Mask)
 * @param InMeshWorldNormal       - Mesh geometric normal from clipmap
 * @param InVolumeTexture         - 3D seamless noise volume texture
 * @param InVolumeSampler         - SamplerState for 3D volume
 * @param InArchetypeIndex        - 0: Earth, 1: Mars, 2: Ice Moon, 3: Volcanic
 * @param InMacroFrequency        - Spatial frequency of macro relief (default: 0.00005 = 200m)
 * @param InMicroFrequency        - Spatial frequency of micro relief (default: 0.01 = 1m)
 * @param InNormalStrength        - Global normal perturbation multiplier
 * @param InSlopeCliffColor       - Tint color applied to steep vertical cliffs
 * @param InSnowColor             - Tint color for dynamic snow accumulation
 * @param InSnowTemperatureThreshold - Visual temperature at which snow begins (default: 0.22)
 * @param InWetnessIntensity      - Intensity of humidity darkening and puddle gloss (default: 1.0)
 * @param OutSurface              - Output: Full physical PBR properties
 */
void EvaluatePlanetarySurface(
    in float3 InWorldPos,
    in float3 InPlanetCenter,
    in float  InPlanetRadius,
    in float3 InCameraWorldPos,
    in float4 InVertexColor,
    in float3 InMeshWorldNormal,
    in Texture3D InVolumeTexture,
    in SamplerState InVolumeSampler,
    in int    InArchetypeIndex,
    in float  InMacroFrequency,
    in float  InMicroFrequency,
    in float  InNormalStrength,
    in float3 InSlopeCliffColor,
    in float3 InSnowColor,
    in float  InSnowTemperatureThreshold,
    in float  InWetnessIntensity,
    out FPlanetarySurfaceOutput OutSurface)
{
    // --- 1. Planetary Surface Geometric Basis ---
    float3 RadialVec = InWorldPos - InPlanetCenter;
    float RadialDist = length(RadialVec);
    float3 N_base = RadialVec / max(RadialDist, 1.0f); // True spherical radial normal
    
    // Mesh normal fallback guard
    float3 N_geom = length(InMeshWorldNormal) > 0.01f ? normalize(InMeshWorldNormal) : N_base;

    // Orthonormal tangent basis on sphere (T1, T2) strictly perpendicular to N_base
    float3 T1, T2;
    GetPlanetaryTangentFrame(N_base, T1, T2);

    // --- 2. Camera Distance LOD & Toksvig Specular Anti-Aliasing ---
    float CamLenSq = dot(InCameraWorldPos, InCameraWorldPos);
    bool bHasCamera = (CamLenSq > 100.0f);
    float CameraDist = bHasCamera ? length(InWorldPos - InCameraWorldPos) : 100000.0f;

    // Continuous distance LOD factors
    float MicroLOD = saturate(1.0f - (CameraDist - PLANETARY_MICRO_FADE_START_CM) 
                            / max(PLANETARY_MICRO_FADE_END_CM - PLANETARY_MICRO_FADE_START_CM, 1000.0f));
    float MacroLOD = saturate(1.0f - (CameraDist - PLANETARY_MACRO_FADE_START_CM) 
                            / max(PLANETARY_MACRO_FADE_END_CM - PLANETARY_MACRO_FADE_START_CM, 10000.0f));

    // Toksvig roughness bias to absorb high-frequency normal variance into microfacet roughness
    float ToksvigBias = saturate((CameraDist - PLANETARY_MICRO_FADE_START_CM) / (PLANETARY_MICRO_FADE_END_CM * 2.0f)) * 0.32f;

    // --- 3. Climatological Inputs & Domain Warping ---
    float AltitudeNorm = saturate(InVertexColor.r);
    float VisualTemp   = saturate(InVertexColor.g);
    float Humidity     = saturate(InVertexColor.b);
    float SurfaceMask  = saturate(InVertexColor.a);

    // Macro 3D noise sample for domain warping (creates natural irregular biome borders)
    float MacroH = 0.5f;
    float3 MacroGrad = float3(0.0f, 0.0f, 0.0f);
    
    float MacroFreq = max(InMacroFrequency, 0.000001f);
    float MacroEps = 200.0f; // 2 meters finite difference
    
    MacroGrad = ComputeVolumeSurfaceGradient(
        InVolumeTexture, InVolumeSampler,
        InWorldPos, T1, T2,
        MacroFreq, MacroEps, MacroH);

    // Domain warp climate space by macro-terrain gradient
    float TempWarped     = saturate(VisualTemp + (MacroH - 0.5f) * 0.12f);
    float HumidityWarped = saturate(Humidity + (MacroGrad.x + MacroGrad.y) * 0.08f);

    // --- 4. Biome Palettes Setup ---
    FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES];
    int BiomeCount = 8;

    if (InArchetypeIndex == 1)
    {
        InitMarsLikeBiomes(Biomes, BiomeCount);
    }
    else if (InArchetypeIndex == 2)
    {
        InitIceMoonBiomes(Biomes, BiomeCount);
    }
    else if (InArchetypeIndex == 3)
    {
        InitVolcanicBiomes(Biomes, BiomeCount);
    }
    else
    {
        InitEarthLikeBiomes(Biomes, BiomeCount);
    }

    // --- 5. Analytical Whittaker Evaluation ---
    float3 BiomeColor;
    float  BiomeRoughness;
    float  BiomeMetallic;
    float  BiomeSpecular;
    float  BiomeMicroTiling;
    float  BiomeNormalScale;

    EvaluateWhittakerBiomes(
        TempWarped,
        HumidityWarped,
        Biomes,
        BiomeCount,
        3.5f, // Smooth transition sharpness
        BiomeColor,
        BiomeRoughness,
        BiomeMetallic,
        BiomeSpecular,
        BiomeMicroTiling,
        BiomeNormalScale);

    // --- 6. Micro Relief & Analytical Normal Perturbation ---
    float3 SurfaceGradient = MacroGrad * (MacroLOD * 0.7f);

    // Early-out / branch micro noise when camera is beyond micro LOD distance
    if (MicroLOD > 0.001f)
    {
        float MicroFreq = max(InMicroFrequency * BiomeMicroTiling, 0.0001f);
        float MicroEps  = 2.0f; // 2 cm finite difference
        float MicroH    = 0.5f;

        float3 MicroGrad = ComputeVolumeSurfaceGradient(
            InVolumeTexture, InVolumeSampler,
            InWorldPos, T1, T2,
            MicroFreq, MicroEps, MicroH);

        SurfaceGradient += MicroGrad * (MicroLOD * BiomeNormalScale);
    }

    // Tangent normal perturbation: strictly perpendicular to N_geom
    float EffNormalStrength = InNormalStrength * (MacroLOD * 0.6f + MicroLOD * 0.4f);
    float3 TangentPerturb = (T1 * dot(SurfaceGradient, T1) + T2 * dot(SurfaceGradient, T2)) * EffNormalStrength;
    
    // (N_geom - TangentPerturb) is guaranteed non-zero and never points inwards
    float3 PerturbedNormal = normalize(N_geom - TangentPerturb);

    // --- 7. Physical Slope Mask & Cliff Bedrock Detection ---
    // Slope is defined by the dot product between planet radial vector and terrain surface normal
    float SlopeCos = saturate(dot(N_base, PerturbedNormal));
    float SlopeFactor = 1.0f - SlopeCos; // 0 on flat plains, 1 on vertical overhangs
    
    // Smooth transition into bare cliff rock between 25 and 45 degrees
    float CliffMask = smoothstep(0.35f, 0.65f, SlopeFactor);

    // Apply cliff rock modulation
    float3 CliffAlbedo = (length(InSlopeCliffColor) > 0.01f) ? InSlopeCliffColor : (BiomeColor * 0.45f);
    float3 BaseAlbedo = lerp(BiomeColor, CliffAlbedo, CliffMask);
    float  EffRoughness = lerp(BiomeRoughness, 0.92f, CliffMask);

    // --- 8. Dynamic Snowline & Glaciation ---
    // Snow accumulates in cold zones (low VisualTemp) but slides off steep cliffs
    float SnowThreshold = max(InSnowTemperatureThreshold, 0.01f);
    float SnowRaw = saturate((SnowThreshold - TempWarped) / max(SnowThreshold * 0.6f, 0.02f));
    
    // Slope damping: snow cannot stick to steep cliffs (SlopeFactor > 0.45)
    float SnowSlopeDamp = smoothstep(0.55f, 0.25f, SlopeFactor);
    float SnowMask = SnowRaw * SnowSlopeDamp;

    if (SnowMask > 0.001f)
    {
        float3 SnowAlbedo = (length(InSnowColor) > 0.01f) ? InSnowColor : float3(0.92f, 0.94f, 0.98f);
        BaseAlbedo   = lerp(BaseAlbedo, SnowAlbedo, SnowMask);
        EffRoughness = lerp(EffRoughness, 0.68f, SnowMask);
        BiomeMetallic = lerp(BiomeMetallic, 0.0f, SnowMask);
        BiomeSpecular = lerp(BiomeSpecular, 0.5f, SnowMask);
    }

    // --- 9. Moisture, Wetness & Puddles ---
    // Wetness darkens porous soil, flattens micro-cavities, and creates specular mirror reflections
    float WetnessMask = 0.0f;
    if (InWetnessIntensity > 0.01f)
    {
        float PuddleDepression = saturate(1.0f - SlopeFactor);
        WetnessMask = saturate((Humidity - 0.45f) / 0.50f) * PuddleDepression * InWetnessIntensity;
        
        // Suppress wetness on snow and steep cliffs
        WetnessMask *= (1.0f - SnowMask) * (1.0f - CliffMask * 0.7f);

        // Porous darkening: water absorption
        BaseAlbedo *= (1.0f - 0.35f * WetnessMask);
        
        // Roughness collapse towards water index of refraction (n=1.33 => roughness 0.02..0.05)
        EffRoughness = lerp(EffRoughness, 0.03f, WetnessMask * 0.88f);
        BiomeSpecular = lerp(BiomeSpecular, 0.55f, WetnessMask);
    }

    // --- 10. Specular Anti-Aliasing (Toksvig Integration) ---
    // Combine base roughness with distance Toksvig bias to eliminate specular fireflies from orbit
    float FinalRoughness = saturate(sqrt(EffRoughness * EffRoughness + ToksvigBias * ToksvigBias));

    // --- 11. Volcanic / Thermal Emission ---
    float3 Emissive = float3(0.0f, 0.0f, 0.0f);
    if (InArchetypeIndex == 3) // Volcanic Mustafar world
    {
        // Low altitude depressions and cracks expose glowing magma
        float MagmaMask = saturate((0.35f - AltitudeNorm) / 0.20f) * saturate(1.0f - SlopeFactor);
        MagmaMask *= saturate(1.0f - MacroH * 1.5f);
        
        float3 MagmaHotColor = float3(2.5f, 0.35f, 0.02f); // Emissive HDR
        Emissive = MagmaHotColor * (MagmaMask * 4.0f);
        BaseAlbedo = lerp(BaseAlbedo, float3(0.05f, 0.02f, 0.01f), MagmaMask);
    }

    // --- 12. Pack Output ---
    OutSurface.BaseColor        = BaseAlbedo;
    OutSurface.WorldNormal      = PerturbedNormal;
    OutSurface.Roughness        = FinalRoughness;
    OutSurface.Metallic         = BiomeMetallic;
    OutSurface.Specular         = BiomeSpecular;
    OutSurface.AmbientOcclusion = lerp(0.85f, 1.0f, MacroH);
    OutSurface.Emissive         = Emissive;
    OutSurface.SnowMask         = SnowMask;
    OutSurface.SlopeMask        = CliffMask;
    OutSurface.WetnessMask      = WetnessMask;
    OutSurface.LODFactor        = MicroLOD;
}

// ============================================================================
// CONVENIENCE ENTRY POINTS FOR UNREAL ENGINE 5 CUSTOM NODES
// ============================================================================

/**
 * Returns BaseColor (float3) for UE Material Custom Node.
 */
float3 EvaluatePlanetaryBaseColor(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return OutSurface.BaseColor;
}

/**
 * Returns Perturbed World Normal (float3) for UE Material Custom Node.
 */
float3 EvaluatePlanetaryNormal(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return OutSurface.WorldNormal;
}

/**
 * Returns Roughness (float) with Toksvig AA for UE Material Custom Node.
 */
float EvaluatePlanetaryRoughness(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return OutSurface.Roughness;
}

/**
 * Returns Emissive (float3) for UE Material Custom Node.
 */
float3 EvaluatePlanetaryEmissive(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return OutSurface.Emissive;
}

/**
 * Returns Packed Diffuse & Roughness: float4(BaseColor.rgb, Roughness)
 * Enables single-node shared evaluation in UE Material Editor!
 */
float4 EvaluatePlanetaryPackedDiffuseRoughness(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return float4(OutSurface.BaseColor, OutSurface.Roughness);
}

/**
 * Returns Packed Normal & AO: float4(WorldNormal.xyz, AmbientOcclusion)
 */
float4 EvaluatePlanetaryPackedNormalAO(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return float4(OutSurface.WorldNormal, OutSurface.AmbientOcclusion);
}

/**
 * Returns Packed Masks: float4(SnowMask, SlopeMask, WetnessMask, Metallic)
 */
float4 EvaluatePlanetaryPackedMasks(
    float3 InWorldPos,
    float3 InPlanetCenter,
    float  InPlanetRadius,
    float3 InCameraWorldPos,
    float4 InVertexColor,
    float3 InMeshWorldNormal,
    Texture3D InVolumeTexture,
    SamplerState InVolumeSampler,
    int    InArchetypeIndex,
    float  InMacroFrequency,
    float  InMicroFrequency,
    float  InNormalStrength,
    float3 InSlopeCliffColor,
    float3 InSnowColor,
    float  InSnowTemperatureThreshold,
    float  InWetnessIntensity)
{
    FPlanetarySurfaceOutput OutSurface;
    EvaluatePlanetarySurface(
        InWorldPos, InPlanetCenter, InPlanetRadius, InCameraWorldPos,
        InVertexColor, InMeshWorldNormal, InVolumeTexture, InVolumeSampler,
        InArchetypeIndex, InMacroFrequency, InMicroFrequency, InNormalStrength,
        InSlopeCliffColor, InSnowColor, InSnowTemperatureThreshold, InWetnessIntensity,
        OutSurface);
    return float4(OutSurface.SnowMask, OutSurface.SlopeMask, OutSurface.WetnessMask, OutSurface.Metallic);
}
