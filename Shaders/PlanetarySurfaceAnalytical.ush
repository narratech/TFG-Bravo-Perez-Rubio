// Copyright Javier Bravo, David Rubio, Sergio Perez 2026 All Rights Reserved.
// PlanetarySurfaceAnalytical.ush - Adaptive Procedural Planetary Surface Shader
// Implements:
//   - Analytical Whittaker Biome Classification in Continuous Climatological Space
//   - Gradient-Based Analytical 3D Normal Perturbation from Seamless Volume Textures
//   - Distance-Based Continuous LOD & Toksvig Specular Anti-Aliasing
//   - Physically-Based PBR Modulation (Slope Bedrock, Dynamic Snowline, Moisture/Puddles)
//   - Multi-Archetype Planetary Palettes (Earth-Like, Mars-Like, Ice Moon, Volcanic)
#pragma once

// ============================================================================
// CONSTANTS & CONFIGURATION
// ============================================================================
#define PLANETARY_MAX_BIOMES 8
#define PLANETARY_PI 3.14159265359f

#ifndef PLANETARY_MICRO_FADE_START_CM
#define PLANETARY_MICRO_FADE_START_CM 50000.0f    // 500 meters: full micro detail
#endif

#ifndef PLANETARY_MICRO_FADE_END_CM
#define PLANETARY_MICRO_FADE_END_CM   300000.0f   // 3.0 kilometers: micro detail completely faded
#endif

#ifndef PLANETARY_MACRO_FADE_START_CM
#define PLANETARY_MACRO_FADE_START_CM 2000000.0f  // 20 kilometers: macro detail begins fade
#endif

#ifndef PLANETARY_MACRO_FADE_END_CM
#define PLANETARY_MACRO_FADE_END_CM   10000000.0f // 100 kilometers: macro detail faded in high orbit
#endif

// ============================================================================
// DATA STRUCTURES
// ============================================================================

/**
 * Biome specification in Whittaker climatological phase space (Temp, Humidity).
 */
struct FPlanetaryBiomeDefinition
{
    float2 ClimatologicalCenter; // (Temperature 0..1, Humidity 0..1)
    float2 ClimatologicalRadius; // (Sigma_Temp, Sigma_Humidity) for Gaussian RBF
    float3 BaseColor;            // Linear RGB Albedo
    float  Roughness;            // PBR Microfacet Roughness
    float  Metallic;             // PBR Metallic
    float  Specular;             // Dielectric Specular F0 (default 0.5)
    float  MicroTiling;          // Normal/relieve micro-tiling multiplier
    float  NormalStrength;       // Local normal bump perturbation intensity
};

/**
 * Complete PBR evaluation output.
 */
struct FPlanetarySurfaceOutput
{
    float3 BaseColor;            // Modulated PBR Base Color (Linear RGB)
    float3 WorldNormal;          // Perturbed World Space Normal
    float  Roughness;            // Final roughness with Toksvig AA
    float  Metallic;             // PBR Metallic
    float  Specular;             // PBR Specular
    float  AmbientOcclusion;     // Micro-crevice & cavity occlusion
    float3 Emissive;             // Surface emission (e.g. lava, bioluminescence)
    
    // Diagnostic / Mask outputs
    float  SnowMask;             // Dynamic accumulation mask [0..1]
    float  SlopeMask;            // Exposed rock / cliff mask [0..1]
    float  WetnessMask;          // Puddle and moisture mask [0..1]
    float  LODFactor;            // Distance LOD blend factor [0..1]
};

// ============================================================================
// MATHEMATICAL HELPER FUNCTIONS
// ============================================================================

/**
 * Constructs a singularity-free, right-handed orthonormal tangent basis (T1, T2)
 * orthogonal to the given planetary radial unit normal N_base.
 * Uses an extended Frisvad / Hughes-Möller tangent formulation.
 */
void GetPlanetaryTangentFrame(in float3 N_base, out float3 OutTangent1, out float3 OutTangent2)
{
    if (N_base.z < -0.9999f)
    {
        OutTangent1 = float3(0.0f, -1.0f, 0.0f);
        OutTangent2 = float3(-1.0f, 0.0f, 0.0f);
    }
    else
    {
        float a = 1.0f / (1.0f + N_base.z);
        float b = -N_base.x * N_base.y * a;
        OutTangent1 = float3(1.0f - N_base.x * N_base.x * a, b, -N_base.x);
        OutTangent2 = float3(b, 1.0f - N_base.y * N_base.y * a, -N_base.y);
    }
}

/**
 * Fast procedural 3D noise hash fallback when 3D texture is unavailable.
 */
float PlanetaryAnalyticalNoise3D(float3 P)
{
    float3 i = floor(P);
    float3 f = frac(P);
    f = f * f * (3.0f - 2.0f * f); // Smoothstep hermite curve

    float3 step = float3(110.0f, 241.0f, 17.0f);
    float n = dot(i, step);

    float4 v1 = frac(sin(n + float4(0.0f, step.x, step.y, step.x + step.y)) * 43758.5453f);
    float4 v2 = frac(sin(n + step.z + float4(0.0f, step.x, step.y, step.x + step.y)) * 43758.5453f);

    float4 v12 = lerp(v1, v2, f.z);
    float2 v12_y = lerp(v12.xz, v12.yw, f.y);
    return lerp(v12_y.x, v12_y.y, f.x);
}

/**
 * Samples seamless 3D volume texture with periodic wrapping.
 */
float SampleVolumeNoise(
    Texture3D InTexture,
    SamplerState InSampler,
    float3 InSamplePosUVW)
{
    // Volume textures generated with seamless wrap addressing
    return InTexture.Sample(InSampler, frac(InSamplePosUVW)).r;
}

/**
 * Computes the directional surface gradient of a 3D volume noise field directly
 * on the sphere's tangent plane using finite forward differences.
 * 
 * Takes only 3 texture samples instead of 6 (or 18 in triplanar) to compute exact
 * directional derivatives:
 *   dH/dT1 = (H(P + eps*T1) - H(P)) / eps
 *   dH/dT2 = (H(P + eps*T2) - H(P)) / eps
 *
 * @param InTexture      - Seamless 3D volume texture (Texture3D)
 * @param InSampler      - Texture SamplerState (Wrap, Trilinear)
 * @param WorldPos       - World position on planet surface (cm)
 * @param T1             - Unit tangent vector 1 (orthogonal to N_base)
 * @param T2             - Unit tangent vector 2 (orthogonal to N_base and T1)
 * @param Frequency      - Spatial frequency (1 / wavelength in cm)
 * @param Epsilon        - Finite difference step distance (cm)
 * @param OutCenterH     - Output: sampled height at center point
 * @return               - Surface gradient vector in tangent space (g1*T1 + g2*T2)
 */
float3 ComputeVolumeSurfaceGradient(
    Texture3D InTexture,
    SamplerState InSampler,
    float3 WorldPos,
    float3 T1,
    float3 T2,
    float Frequency,
    float Epsilon,
    out float OutCenterH)
{
    float3 UV0 = WorldPos * Frequency;
    float3 UV1 = (WorldPos + T1 * Epsilon) * Frequency;
    float3 UV2 = (WorldPos + T2 * Epsilon) * Frequency;

    float H0 = SampleVolumeNoise(InTexture, InSampler, UV0);
    float H1 = SampleVolumeNoise(InTexture, InSampler, UV1);
    float H2 = SampleVolumeNoise(InTexture, InSampler, UV2);

    OutCenterH = H0;

    float InvEps = 1.0f / max(Epsilon, 0.001f);
    float dH_dT1 = (H1 - H0) * InvEps;
    float dH_dT2 = (H2 - H0) * InvEps;

    return (T1 * dH_dT1 + T2 * dH_dT2);
}

// ============================================================================
// WHITTAKER ANALYTICAL BIOME CLASSIFICATION
// ============================================================================

/**
 * Evaluates continuous analytical Whittaker biomes via Softmin / Gaussian Radial
 * Basis Functions (RBF) in the 2D climatological space (Temperature, Humidity).
 *
 * Eliminates 2D LUT texture fetches, bilinear compression artifacts, and color banding.
 * Allows smooth, mathematically guaranteed continuous interpolation across all biomes.
 */
void EvaluateWhittakerBiomes(
    in float ClimatologicalTemp,
    in float ClimatologicalHumidity,
    in FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES],
    in int ActiveBiomeCount,
    in float SoftnessFactor,
    out float3 OutBaseColor,
    out float  OutRoughness,
    out float  OutMetallic,
    out float  OutSpecular,
    out float  OutMicroTiling,
    out float  OutNormalStrength)
{
    float Weights[PLANETARY_MAX_BIOMES];
    float TotalWeight = 0.0f;
    float Sharpness = max(SoftnessFactor, 1.0f);

    // Compute Gaussian RBF distance to each biome centroid
    [unroll]
    for (int i = 0; i < PLANETARY_MAX_BIOMES; ++i)
    {
        if (i < ActiveBiomeCount)
        {
            float2 Delta = (float2(ClimatologicalTemp, ClimatologicalHumidity) - Biomes[i].ClimatologicalCenter) 
                         / max(Biomes[i].ClimatologicalRadius, float2(0.02f, 0.02f));
            float DistSq = dot(Delta, Delta);
            
            // Softmin exponential kernel
            float W = exp(-0.5f * DistSq * Sharpness);
            Weights[i] = W;
            TotalWeight += W;
        }
        else
        {
            Weights[i] = 0.0f;
        }
    }

    TotalWeight = max(TotalWeight, 0.0001f);
    float InvTotal = 1.0f / TotalWeight;

    // Accumulate blended PBR attributes
    float3 ColorAccum = float3(0.0f, 0.0f, 0.0f);
    float  RoughAccum = 0.0f;
    float  MetalAccum = 0.0f;
    float  SpecAccum  = 0.0f;
    float  TileAccum  = 0.0f;
    float  NormAccum  = 0.0f;

    [unroll]
    for (int k = 0; k < PLANETARY_MAX_BIOMES; ++k)
    {
        if (k < ActiveBiomeCount)
        {
            float NormalizedW = Weights[k] * InvTotal;
            ColorAccum += Biomes[k].BaseColor * NormalizedW;
            RoughAccum += Biomes[k].Roughness * NormalizedW;
            MetalAccum += Biomes[k].Metallic * NormalizedW;
            SpecAccum  += Biomes[k].Specular * NormalizedW;
            TileAccum  += Biomes[k].MicroTiling * NormalizedW;
            NormAccum  += Biomes[k].NormalStrength * NormalizedW;
        }
    }

    OutBaseColor      = ColorAccum;
    OutRoughness      = saturate(RoughAccum);
    OutMetallic       = saturate(MetalAccum);
    OutSpecular       = saturate(SpecAccum);
    OutMicroTiling    = max(TileAccum, 0.1f);
    OutNormalStrength = NormAccum;
}

// ============================================================================
// PLANETARY ARCHETYPE PRESETS
// ============================================================================

/**
 * Initializes Earth-Like terrestrial archetype:
 *   0: Polar Ice / Glacial
 *   1: Tundra
 *   2: Taiga / Boreal Conifer
 *   3: Temperate Grassland
 *   4: Temperate Deciduous Forest
 *   5: Arid Sand Desert
 *   6: Savannah / Scrubland
 *   7: Tropical Rainforest
 */
void InitEarthLikeBiomes(out FPlanetaryBiomeDefinition Biomes[PLANETARY_MAX_BIOMES], out int BiomeCount)
{
    BiomeCount = 8;

    // 0: Polar Ice / Glacial
    Biomes[0].ClimatologicalCenter = float2(0.05f, 0.20f);
    Biomes[0].ClimatologicalRadius = float2(0.18f, 0.30f);
    Biomes[0].BaseColor            = float3(0.88f, 0.92f, 0.96f);
    Biomes[0].Roughness            = 0.35f;
    Biomes[0].Metallic             = 0.00f;
    Biomes[0].Specular             = 0.55f;
    Biomes[0].MicroTiling          = 2.0f;
    Biomes[0].NormalStrength       = 0.6f;

    // 1: Tundra
    Biomes[1].ClimatologicalCenter = float2(0.20f, 0.30f);
    Biomes[1].ClimatologicalRadius = float2(0.18f, 0.25f);
    Biomes[1].BaseColor            = float3(0.42f, 0.40f, 0.32f);
    Biomes[1].Roughness            = 0.85f;
    Biomes[1].Metallic             = 0.00f;
    Biomes[1].Specular             = 0.40f;
    Biomes[1].MicroTiling          = 1.5f;
    Biomes[1].NormalStrength       = 1.0f;

    // 2: Taiga / Boreal Conifer
    Biomes[2].ClimatologicalCenter = float2(0.35f, 0.60f);
    Biomes[2].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[2].BaseColor            = float3(0.12f, 0.22f, 0.10f);
    Biomes[2].Roughness            = 0.75f;
    Biomes[2].Metallic             = 0.00f;
    Biomes[2].Specular             = 0.45f;
    Biomes[2].MicroTiling          = 1.2f;
    Biomes[2].NormalStrength       = 1.1f;

    // 3: Temperate Grassland
    Biomes[3].ClimatologicalCenter = float2(0.55f, 0.30f);
    Biomes[3].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[3].BaseColor            = float3(0.32f, 0.38f, 0.16f);
    Biomes[3].Roughness            = 0.70f;
    Biomes[3].Metallic             = 0.00f;
    Biomes[3].Specular             = 0.45f;
    Biomes[3].MicroTiling          = 1.0f;
    Biomes[3].NormalStrength       = 0.9f;

    // 4: Temperate Deciduous Forest
    Biomes[4].ClimatologicalCenter = float2(0.60f, 0.70f);
    Biomes[4].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[4].BaseColor            = float3(0.14f, 0.30f, 0.09f);
    Biomes[4].Roughness            = 0.65f;
    Biomes[4].Metallic             = 0.00f;
    Biomes[4].Specular             = 0.48f;
    Biomes[4].MicroTiling          = 1.0f;
    Biomes[4].NormalStrength       = 0.9f;

    // 5: Arid Sand Desert
    Biomes[5].ClimatologicalCenter = float2(0.85f, 0.12f);
    Biomes[5].ClimatologicalRadius = float2(0.22f, 0.20f);
    Biomes[5].BaseColor            = float3(0.76f, 0.58f, 0.35f);
    Biomes[5].Roughness            = 0.90f;
    Biomes[5].Metallic             = 0.00f;
    Biomes[5].Specular             = 0.35f;
    Biomes[5].MicroTiling          = 3.0f;
    Biomes[5].NormalStrength       = 0.7f;

    // 6: Savannah / Scrubland
    Biomes[6].ClimatologicalCenter = float2(0.80f, 0.42f);
    Biomes[6].ClimatologicalRadius = float2(0.20f, 0.25f);
    Biomes[6].BaseColor            = float3(0.55f, 0.48f, 0.22f);
    Biomes[6].Roughness            = 0.80f;
    Biomes[6].Metallic             = 0.00f;
    Biomes[6].Specular             = 0.40f;
    Biomes[6].MicroTiling          = 1.2f;
    Biomes[6].NormalStrength       = 0.85f;

    // 7: Tropical Rainforest
    Biomes[7].ClimatologicalCenter = float2(0.85f, 0.85f);
    Biomes[7].ClimatologicalRadius = float2(0.22f, 0.22f);
    Biomes[7].BaseColor            = float3(0.06f, 0.20f, 0.05f);
    Biomes[7].Roughness            = 0.55f;
    Biomes[7].Metallic             = 0.00f;
    Biomes[7].Specular             = 0.50f;
    Biomes[7].MicroTiling          = 0.8f;
    Biomes[7].NormalStrength       = 1.2f;
}

/**
 * Initializes Mars-Like ferric desert / barren rocky archetype:
 *   0: Polar CO2 Dry Ice Caps
 *   1: High Altitude Basaltic Plateau
 *   2: Ferric Orange Sand Dunes
 *   3: Deep Canyon Ochre Rock
 *   4: Dark Basalt Ejecta Plains
 */
